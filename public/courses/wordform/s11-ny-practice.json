{"id": "s11-ny-practice", "title": "Practice 1: -ный, -ной, -ский", "blocks": [{"t": "note", "text": "Sentences and their English: Tatoeba (tatoeba.org, CC BY 2.0 FR). Words, meanings and how each word is built: the English Wiktionary (CC BY-SA 4.0)."}], "exercises": [{"type": "fill", "q": "знать → ___", "answers": ["знатный", "зна́тный"], "hint": "the adjective in -ный", "why": "**зна́тный** — noble. Wiktionary: знать + -ный.", "id": "q1"}, {"type": "fill", "q": "рука → ___", "answers": ["ручной", "ручно́й"], "hint": "the adjective in -ной", "why": "**ручно́й** — (relational) hand; manual. Wiktionary: рука́ + -но́й.", "id": "q2"}, {"type": "fill", "q": "стать → ___", "answers": ["статный", "ста́тный"], "hint": "the adjective in -ный", "why": "**ста́тный** — stately. Wiktionary: стать + -ный.", "id": "q3"}, {"type": "fill", "q": "лицо → ___", "answers": ["личный", "ли́чный"], "hint": "the adjective in -ный", "why": "**ли́чный** — personal (relating to a particular person). Wiktionary: лицо́ + -ный.", "id": "q4"}, {"type": "match", "q": "Match each word with its meaning (Wiktionary's definitions).", "pairs": [["зна́тный", "noble"], ["ручно́й", "(relational) hand; manual"], ["ста́тный", "stately"], ["ли́чный", "personal (relating to a particular person)"]], "why": "From Wiktionary: зна́тный — noble; ручно́й — (relational) hand; manual; ста́тный — stately; ли́чный — personal (relating to a particular person).", "id": "q5"}, {"type": "fill", "q": "дело → ___", "answers": ["дельный", "де́льный"], "hint": "the adjective in -ный", "why": "**де́льный** — efficient, businesslike. Wiktionary: де́ло + -ный.", "id": "q6"}, {"type": "fill", "q": "мир → ___", "answers": ["мирный", "ми́рный"], "hint": "the adjective in -ный", "why": "**ми́рный** — (relational) peace. Wiktionary: мир + -ный.", "id": "q7"}, {"type": "fill", "q": "мир → ___", "answers": ["мирской", "мирско́й"], "hint": "the adjective in -ской", "why": "**мирско́й** — (relational, dated) society, community. Wiktionary: мир + -ско́й.", "id": "q8"}, {"type": "fill", "q": "си́ла → ___", "answers": ["сильный", "си́льный"], "hint": "the adjective in -ный", "why": "**си́льный** — strong, powerful. Wiktionary: си́ла + -ный.", "id": "q9"}, {"type": "match", "q": "Match each word with its meaning (Wiktionary's definitions).", "pairs": [["де́льный", "efficient, businesslike"], ["ми́рный", "(relational) peace"], ["мирско́й", "(relational, dated) society, community"], ["си́льный", "strong, powerful"]], "why": "From Wiktionary: де́льный — efficient, businesslike; ми́рный — (relational) peace; мирско́й — (relational, dated) society, community; си́льный — strong, powerful.", "id": "q10"}, {"type": "fill", "q": "свет → ___", "answers": ["светский", "све́тский"], "hint": "the adjective in -ский", "why": "**све́тский** — (relational) society, high-society. Wiktionary: свет + -ский.", "id": "q11"}, {"type": "fill", "q": "вид → ___", "answers": ["видный", "ви́дный"], "hint": "the adjective in -ный", "why": "**ви́дный** — visible, conspicuous. Wiktionary: вид + -ный.", "id": "q12"}]}