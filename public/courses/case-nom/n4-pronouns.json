{
 "id": "n4-pronouns",
 "title": "Pronouns in the nominative",
 "blocks": [
  {
   "t": "p",
   "text": "The personal pronouns (words used to denote the speaker) are:",
   "set": true
  },
  {
   "t": "table",
   "head": [
    "",
    "Singular",
    "Plural"
   ],
   "rows": [
    [
     "1st-person",
     "Я ('I')",
     "Мы ('We')"
    ],
    [
     "2nd-person",
     "Ты ('You', informal)",
     "Вы ('You', polite/plural)"
    ],
    [
     "3rd-person",
     "Он/она/оно ('He', 'She', 'It')",
     "Они ('They')"
    ]
   ],
   "rowHeads": true
  },
  {
   "t": "p",
   "text": "The possessive pronouns are as follows:",
   "set": true
  },
  {
   "t": "table",
   "head": [
    "",
    "Masculine",
    "Feminine",
    "Neuter",
    "Plural"
   ],
   "rows": [
    [
     "My",
     "Мой",
     "Моя",
     "Моё",
     "Мои"
    ],
    [
     "Your (informal)",
     "Твой",
     "Твоя",
     "Твоё",
     "Твои"
    ],
    [
     "Our",
     "Наш",
     "Наша",
     "Наше",
     "Наши"
    ],
    [
     "Your (polite/plural)",
     "Ваш",
     "Ваша",
     "Ваше",
     "Ваши"
    ]
   ],
   "rowHeads": true
  },
  {
   "t": "p",
   "text": "'His' and 'its' are **его** ('ye-voh'), 'her' is **её** ('ye-yoh'), and 'their' is **их** ('eekh'), and these do not change with the gender or number of the possessed object.",
   "set": true
  },
  {
   "t": "note",
