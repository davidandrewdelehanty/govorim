{"id":"t7-words","title":"Days, months and seasons","blocks":[{"t":"note","text":"This section is from the Wikibooks Russian textbook (en.wikibooks.org/wiki/Russian, “Vocabulary/Days of the Week”, “Months”, “Seasons”), licensed CC BY-SA 4.0."},{"t":"h","text":"Days of the Week"},{"t":"p","text":"Russians don't capitalize days of the week."},{"t":"table","head":["Russian","English","Transcription"],"rows":[["день","day","dyehn"],["сегодня","today","sevódnya"],["понедельник","Monday","ponyedyél'nik"],["вторник","Tuesday","vtórnik"],["среда","Wednesday","sryéda"],["четверг","Thursday","chetvérg"],["пятница","Friday","pyátnitsa"],["суббота","Saturday","soobbóta"],["воскресенье","Sunday","voskresén'ye"],["Какой сегодня день?","What day is it?","Kakóy sevódnya dyen'?"]],"rowHeads":false},{"t":"p","text":"The г in сегодня is pronounced as a в."},{"t":"h","text":"Months of the year"},{"t":"table","head":["Russian","English","Transcription"],"rows":[["месяц","Month","Mésyats"],["год","Year","Goad"],["январь","January","Yanvár'"],["февраль","February","Fevrál'"],["март","March","Mart"],["апрель","April","Aprél'"],["май","May","Mai"],["июнь","June","Iyún'"],["июль","July","Iyúl'"],["август","August","Avgust"],["сентябрь","September","Sentyábr'"],["октябрь","October","Oktyábr'"],["ноябрь","November","Noyábr'"],["декабрь","December","Dekábr'"]],"rowHeads":false},{"t":"h","text":"Seasons"},{"t":"table","head":["Russian","English"],"rows":[["весна́","spring"],["ле́то","summer"],["о́сень","autumn (fall)"],["зима́","winter"]],"rowHeads":false}],"exercises":[]}