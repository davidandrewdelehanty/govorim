{"id": "c1-comparative-practice-3", "title": "Practice 3: The comparative: новее, интереснее", "blocks": [{"t": "note", "text": "Exercises: sentences from Tatoeba (tatoeba.org, CC BY 2.0 FR) and from the library's public-domain books."}], "exercises": [{"type": "fill", "q": "Это не ___ (страшный, comp.) немцев.", "prompt": "This isn't any scarier than the Germans.", "answers": ["страшнее"], "why": "**страшный → страшнее** — comparative: stem + -ее (-ей).", "id": "q1", "context": ""}, {"type": "fill", "q": "Реальность намного ___ (прозаичный, comp.).", "prompt": "The reality is far more mundane.", "answers": ["прозаичнее"], "why": "**прозаичный → прозаичнее** — comparative: stem + -ее (-ей).", "id": "q2", "context": ""}, {"type": "fill", "q": "Маленькая машина ___ (экономичный, comp.), чем большая.", "prompt": "A small car is more economical than a large one.", "answers": ["экономичнее"], "why": "**экономичный → экономичнее** — comparative: stem + -ее (-ей).", "id": "q3", "context": ""}, {"type": "fill", "q": "Волосы Джинни были ___ (голубой, comp.) её глаз.", "prompt": "Jeannie's hair was bluer than her eyes.", "answers": ["голубее"], "why": "**голубой → голубее** — comparative: stem + -ее (-ей).", "id": "q4", "context": ""}, {"type": "fill", "q": "Мэри ___ (симпатичный, comp.) тебя.", "prompt": "Mary is prettier than you.", "answers": ["симпатичнее"], "why": "**симпатичный → симпатичнее** — comparative: stem + -ее (-ей).", "id": "q5", "context": ""}, {"type": "fill", "q": "Лейла намного ___ (красивый, comp.) Салимы.", "prompt": "Layla is much prettier than Salima.", "answers": ["красивее"], "why": "**красивый → красивее** — comparative: stem + -ее (-ей).", "id": "q6", "context": ""}, {"type": "fill", "q": "Том ___ (спортивный, comp.) Чарльза.", "prompt": "Tom is sportier than Charles.", "answers": ["спортивнее"], "why": "**спортивный → спортивнее** — comparative: stem + -ее (-ей).", "id": "q7", "context": ""}, {"type": "fill", "q": "Иногда бабушка ___ (опасный, comp.) спецслужб.", "prompt": "Sometimes, Grandma is more dangerous than the KGB.", "answers": ["опаснее"], "why": "**опасный → опаснее** — comparative: stem + -ее (-ей).", "id": "q8", "context": ""}, {"type": "fill", "q": "Постараемся быть ___ (толерантный, comp.).", "prompt": "Let's try to be more tolerant.", "answers": ["толерантнее"], "why": "**толерантный → толерантнее** — comparative: stem + -ее (-ей).", "id": "q9", "context": ""}, {"type": "fill", "q": "Вам надо быть ___ (организованный, comp.)!", "prompt": "You gotta get more organized.", "answers": ["организованнее"], "why": "**организованный → организованнее** — comparative: stem + -ее (-ей).", "id": "q10", "context": ""}, {"type": "fill", "q": "Нет звука ___ (приятный, comp.) скрежета зубов коллеги.", "prompt": "There is no sound more pleasant than a colleague's gnashing of teeth.", "answers": ["приятнее"], "why": "**приятный → приятнее** — comparative: stem + -ее (-ей).", "id": "q11", "context": ""}, {"type": "fill", "q": "Прогноз погоды оповещает, что завтра будет ___ (прохладный, comp.).", "prompt": "The weather forecast says it will be cooler tomorrow.", "answers": ["прохладнее"], "why": "**прохладный → прохладнее** — comparative: stem + -ее (-ей).", "id": "q12", "context": ""}, {"type": "fill", "q": "Картон ___ (прочный, comp.) бумаги.", "prompt": "Cardboard is stronger than paper.", "answers": ["прочнее"], "why": "**прочный → прочнее** — comparative: stem + -ее (-ей).", "id": "q13", "context": ""}, {"type": "fill", "q": "Он учится гораздо ___ (интенсивный, comp.), чем раньше.", "prompt": "He studies much harder than before.", "answers": ["интенсивнее"], "why": "**интенсивный → интенсивнее** — comparative: stem + -ее (-ей).", "id": "q14", "context": ""}, {"type": "fill", "q": "Реальность гораздо ___ (заурядный, comp.).", "prompt": "The reality is far more mundane.", "answers": ["зауряднее"], "why": "**заурядный → зауряднее** — comparative: stem + -ее (-ей).", "id": "q15", "context": ""}, {"type": "fill", "q": "Новый офис ___ (просторный, comp.).", "prompt": "The new office is more spacious.", "answers": ["просторнее"], "why": "**просторный → просторнее** — comparative: stem + -ее (-ей).", "id": "q16", "context": ""}, {"type": "fill", "q": "Том ___ (талантливый, comp.) брата.", "prompt": "Tom has more talent than his brother.", "answers": ["талантливее"], "why": "**талантливый → талантливее** — comparative: stem + -ее (-ей).", "id": "q17", "context": ""}, {"type": "fill", "q": "Это ___ (весёлый, comp.), чем чаи распивать.", "prompt": "It's more fun than drinking tea.", "answers": ["веселее"], "why": "**весёлый → веселее** — comparative: stem + -ее (-ей).", "id": "q18", "context": ""}, {"type": "fill", "q": "Смех ___ (заразительный, comp.) слёз.", "prompt": "Laughter is more contagious than crying.", "answers": ["заразительнее"], "why": "**заразительный → заразительнее** — comparative: stem + -ее (-ей).", "id": "q19", "context": ""}, {"type": "fill", "q": "Этот ковёр ___ (качественный, comp.) того.", "prompt": "This carpet is superior to that one in quality.", "answers": ["качественнее"], "why": "**качественный → качественнее** — comparative: stem + -ее (-ей).", "id": "q20", "context": ""}]}