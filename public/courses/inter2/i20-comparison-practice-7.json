{"id": "i20-comparison-practice-7", "title": "Practice 7: Expressing comparison", "blocks": [{"t": "note", "text": "Exercises: sentences from Tatoeba (tatoeba.org, CC BY 2.0 FR) and from the library's public-domain books."}], "exercises": [{"type": "fill", "q": "Нет звука ___ (приятный) скрежета зубов коллеги.", "prompt": "There is no sound more pleasant than a colleague's gnashing of teeth.", "answers": ["приятнее"], "why": "**приятный → приятнее** — comparative: stem + -ее (-ей).", "id": "q1", "context": ""}, {"type": "fill", "q": "Прогноз погоды оповещает, что завтра будет ___ (прохладный).", "prompt": "The weather forecast says it will be cooler tomorrow.", "answers": ["прохладнее"], "why": "**прохладный → прохладнее** — comparative: stem + -ее (-ей).", "id": "q2", "context": ""}, {"type": "fill", "q": "Картон ___ (прочный) бумаги.", "prompt": "Cardboard is stronger than paper.", "answers": ["прочнее"], "why": "**прочный → прочнее** — comparative: stem + -ее (-ей).", "id": "q3", "context": ""}, {"type": "fill", "q": "Он учится гораздо ___ (интенсивный), чем раньше.", "prompt": "He studies much harder than before.", "answers": ["интенсивнее"], "why": "**интенсивный → интенсивнее** — comparative: stem + -ее (-ей).", "id": "q4", "context": ""}, {"type": "fill", "q": "Реальность гораздо ___ (заурядный).", "prompt": "The reality is far more mundane.", "answers": ["зауряднее"], "why": "**заурядный → зауряднее** — comparative: stem + -ее (-ей).", "id": "q5", "context": ""}, {"type": "fill", "q": "Новый офис ___ (просторный).", "prompt": "The new office is more spacious.", "answers": ["просторнее"], "why": "**просторный → просторнее** — comparative: stem + -ее (-ей).", "id": "q6", "context": ""}, {"type": "fill", "q": "Том ___ (талантливый) брата.", "prompt": "Tom has more talent than his brother.", "answers": ["талантливее"], "why": "**талантливый → талантливее** — comparative: stem + -ее (-ей).", "id": "q7", "context": ""}, {"type": "fill", "q": "Это ___ (весёлый), чем чаи распивать.", "prompt": "It's more fun than drinking tea.", "answers": ["веселее"], "why": "**весёлый → веселее** — comparative: stem + -ее (-ей).", "id": "q8", "context": ""}, {"type": "fill", "q": "Смех ___ (заразительный) слёз.", "prompt": "Laughter is more contagious than crying.", "answers": ["заразительнее"], "why": "**заразительный → заразительнее** — comparative: stem + -ее (-ей).", "id": "q9", "context": ""}, {"type": "fill", "q": "Этот ковёр ___ (качественный) того.", "prompt": "This carpet is superior to that one in quality.", "answers": ["качественнее"], "why": "**качественный → качественнее** — comparative: stem + -ее (-ей).", "id": "q10", "context": ""}]}