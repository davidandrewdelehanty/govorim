{"id": "i20-comparison-practice-6", "title": "Practice 6: Expressing comparison", "blocks": [{"t": "note", "text": "Exercises: sentences from Tatoeba (tatoeba.org, CC BY 2.0 FR) and from the library's public-domain books."}], "exercises": [{"type": "fill", "q": "Это не ___ (страшный, comp.) немцев.", "prompt": "This isn't any scarier than the Germans.", "answers": ["страшнее"], "why": "**страшный → страшнее** — comparative: stem + -ее (-ей).", "id": "q1", "context": ""}, {"type": "fill", "q": "Реальность намного ___ (прозаичный, comp.).", "prompt": "The reality is far more mundane.", "answers": ["прозаичнее"], "why": "**прозаичный → прозаичнее** — comparative: stem + -ее (-ей).", "id": "q2", "context": ""}, {"type": "fill", "q": "Маленькая машина ___ (экономичный, comp.), чем большая.", "prompt": "A small car is more economical than a large one.", "answers": ["экономичнее"], "why": "**экономичный → экономичнее** — comparative: stem + -ее (-ей).", "id": "q3", "context": ""}, {"type": "fill", "q": "Волосы Джинни были ___ (голубой, comp.) её глаз.", "prompt": "Jeannie's hair was bluer than her eyes.", "answers": ["голубее"], "why": "**голубой → голубее** — comparative: stem + -ее (-ей).", "id": "q4", "context": ""}, {"type": "fill", "q": "Мэри ___ (симпатичный, comp.) тебя.", "prompt": "Mary is prettier than you.", "answers": ["симпатичнее"], "why": "**симпатичный → симпатичнее** — comparative: stem + -ее (-ей).", "id": "q5", "context": ""}, {"type": "fill", "q": "Лейла намного ___ (красивый, comp.) Салимы.", "prompt": "Layla is much prettier than Salima.", "answers": ["красивее"], "why": "**красивый → красивее** — comparative: stem + -ее (-ей).", "id": "q6", "context": ""}, {"type": "fill", "q": "Том ___ (спортивный, comp.) Чарльза.", "prompt": "Tom is sportier than Charles.", "answers": ["спортивнее"], "why": "**спортивный → спортивнее** — comparative: stem + -ее (-ей).", "id": "q7", "context": ""}, {"type": "fill", "q": "Иногда бабушка ___ (опасный, comp.) спецслужб.", "prompt": "Sometimes, Grandma is more dangerous than the KGB.", "answers": ["опаснее"], "why": "**опасный → опаснее** — comparative: stem + -ее (-ей).", "id": "q8", "context": ""}, {"type": "fill", "q": "Постараемся быть ___ (толерантный, comp.).", "prompt": "Let's try to be more tolerant.", "answers": ["толерантнее"], "why": "**толерантный → толерантнее** — comparative: stem + -ее (-ей).", "id": "q9", "context": ""}, {"type": "fill", "q": "Вам надо быть ___ (организованный, comp.)!", "prompt": "You gotta get more organized.", "answers": ["организованнее"], "why": "**организованный → организованнее** — comparative: stem + -ее (-ей).", "id": "q10", "context": ""}]}