        },
        {
          "word": "Одессу,",
          "begin": 104.601,
          "end": 106.443
        },
        {
          "word": "Севастополь.",
          "begin": 106.463,
          "end": 110.486
        }
      ]
    },
    {
      "text": "Над нашей Родиной нависла серьезная опасность.",
      "begin": 110.546,
      "end": 115.49,
      "words": [
        {
          "word": "Над",
          "begin": 110.546,
          "end": 110.786
        },
        {
          "word": "нашей",
          "begin": 110.826,
          "end": 111.567
        },
        {
          "word": "Родиной",
          "begin": 111.687,
          "end": 113.068
        },
        {
          "word": "нависла",
          "begin": 113.108,
          "end": 114.289
        },
        {
          "word": "серьезная",
          "begin": 114.309,
          "end": 114.91
        },
        {
          "word": "опасность.",
          "begin": 114.93,
          "end": 115.49
        }
      ]
    },
    {
      "text": "Как могло случиться, что наша славная Красная Армия сдала фашистским войскам ряд наших городов и районов?",
      "begin": 118.182,
      "end": 134.349,
      "words": [
        {
          "word": "Как",
          "begin": 118.182,
          "end": 118.642
        },
        {
          "word": "могло",
          "begin": 118.702,
          "end": 119.082
        },
        {
          "word": "случиться,",
          "begin": 119.142,
          "end": 120.963
        },
        {
          "word": "что",
          "begin": 120.983,
          "end": 121.143
        },
        {
          "word": "наша",
          "begin": 121.183,
          "end": 121.443
        },
        {
          "word": "славная",
          "begin": 121.503,
          "end": 122.144
        },
        {
          "word": "Красная",
          "begin": 122.204,
          "end": 122.704
        },
        {
          "word": "Армия",
          "begin": 122.784,
          "end": 124.184
        },
        {
          "word": "сдала",
          "begin": 124.224,
          "end": 126.085
        },
        {
          "word": "фашистским",
          "begin": 126.105,
          "end": 126.785
        },
        {
          "word": "войскам",
          "begin": 126.825,
          "end": 128.966
        },
        {
          "word": "ряд",
          "begin": 129.006,
          "end": 130.047
        },
        {
          "word": "наших",
          "begin": 130.107,
          "end": 131.227
        },
        {
          "word": "городов",
          "begin": 131.287,
          "end": 132.168
        },
        {
          "word": "и",
          "begin": 132.188,
          "end": 132.208
        },
        {
          "word": "районов?",
          "begin": 132.228,
          "end": 134.349
        }
      ]
    },
    {
      "text": "Неужели немецко-фашистские войска в самом деле являются непобедимыми войсками?",
      "begin": 134.389,
      "end": 144.032,
      "words": [
        {
          "word": "Неужели",
          "begin": 134.389,
          "end": 135.649
        },
        {
          "word": "немецко-фашистские",
          "begin": 135.689,
          "end": 136.729
        },
        {
          "word": "войска",
          "begin": 136.769,
          "end": 137.87
        },
        {
          "word": "в",
          "begin": 137.89,
          "end": 137.91
        },
        {
          "word": "самом",
          "begin": 137.95,
          "end": 138.41
        },
        {
          "word": "деле",
          "begin": 138.43,
          "end": 138.69
        },
        {
          "word": "являются",
          "begin": 138.75,
          "end": 141.251
        },
        {
          "word": "непобедимыми",
          "begin": 141.291,
          "end": 141.932
        },
        {
          "word": "войсками?",
          "begin": 141.992,
          "end": 144.032
        }
      ]
    },
    {
      "text": "как об этом трубят неустанно фашистские хвастливые пропагандисты?",
      "begin": 144.052,
      "end": 150.822,
      "words": [
        {
          "word": "как",
          "begin": 144.052,
          "end": 144.192
        },
        {
          "word": "об",
          "begin": 144.212,
          "end": 144.313
        },
        {
          "word": "этом",
          "begin": 144.353,
          "end": 144.553
        },
        {
          "word": "трубят",
          "begin": 144.633,
          "end": 145.533
        },
        {
          "word": "неустанно",
          "begin": 145.573,
          "end": 146.954
        },
        {
          "word": "фашистские",
          "begin": 146.994,
          "end": 147.734
        },
        {
          "word": "хвастливые",
          "begin": 148.58,
          "end": 149.06
        },
        {
          "word": "пропагандисты?",
          "begin": 149.121,
          "end": 150.822
        }
      ]
    },
    {
      "text": "Конечно, нет.",
      "begin": 150.842,
      "end": 161.811,
      "words": [
        {
          "word": "Конечно,",
          "begin": 150.842,
          "end": 151.723
        },
        {
          "word": "нет.",
          "begin": 151.803,
          "end": 161.811
        }
      ]
    },
    {
      "text": "История показывает, что непобедимых армий нет и не бывало.",
      "begin": 161.891,
      "end": 169.757,
      "words": [
        {
          "word": "История",
          "begin": 161.891,
          "end": 162.351
        },
        {
          "word": "показывает,",
          "begin": 162.391,
          "end": 164.093
        },
        {
          "word": "что",
          "begin": 164.113,
          "end": 164.253
        },
        {
          "word": "непобедимых",
          "begin": 164.273,
          "end": 164.993
        },
        {
          "word": "армий",
          "begin": 165.093,
          "end": 165.954
        },
        {
          "word": "нет",
          "begin": 166.054,
          "end": 166.895
        },
        {
          "word": "и",
          "begin": 166.955,
          "end": 166.995
        },
        {
          "word": "не",
          "begin": 167.035,
          "end": 167.115
        },
        {
          "word": "бывало.",
          "begin": 167.155,
          "end": 169.757
        }
      ]
    },
    {
      "text": "Армию Наполеона считали непобедимой, но она была разбита попеременно русскими английскими, немецкими войсками.",
      "begin": 169.857,
      "end": 181.844,
      "words": [
        {
          "word": "Армию",
          "begin": 169.857,
          "end": 170.137
        },
        {
          "word": "Наполеона",
          "begin": 170.237,
          "end": 170.858
        },
        {
          "word": "считали",
          "begin": 170.878,
          "end": 171.258
        },
        {
          "word": "непобедимой,",
          "begin": 171.298,
          "end": 173.28
        },
        {
          "word": "но",
          "begin": 173.32,
          "end": 173.42
        },
        {
          "word": "она",
          "begin": 173.44,
          "end": 173.58
        },
        {
          "word": "была",
          "begin": 173.62,
          "end": 173.84
        },
        {
          "word": "разбита",
          "begin": 173.88,
          "end": 175.041
        },
        {
          "word": "попеременно",
          "begin": 175.101,
          "end": 176.302
        },
        {
          "word": "русскими",
          "begin": 176.402,
          "end": 176.943
        },
        {
          "word": "английскими,",
          "begin": 177.723,
          "end": 178.643
        },
        {
          "word": "немецкими",
          "begin": 178.683,
          "end": 179.223
        },
        {
          "word": "войсками.",
          "begin": 179.243,
          "end": 181.844
        }
      ]
    },
    {
      "text": "Немецкую армию Вильгельмов вперед первой империалистической войны тоже считали непобедимой армией, но она несколько раз терпела поражения от русских и англо-французских войск и, наконец, была разбита англо-французскими войсками.",
      "begin": 181.884,
      "end": 200.389,
