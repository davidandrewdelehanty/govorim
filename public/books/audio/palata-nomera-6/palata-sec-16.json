{"audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/palata-nomera-6-split/palata-sec-16.mp3", "narrator": "audiobook", "fragments": [{"text": "Непременно.", "begin": 0.961, "end": 6.246, "words": [{"word": "Непременно.", "begin": 0.961, "end": 6.246}]}, {"text": "Глава шестнадцатая Однажды Михаил Аверьянович пришел после обеда, когда Андрей Ефимович лежал на диване.", "begin": 6.306, "end": 20.351, "words": [{"word": "Глава", "begin": 6.306, "end": 6.566}, {"word": "шестнадцатая", "begin": 6.586, "end": 7.347}, {"word": "Однажды", "begin": 10.304, "end": 11.665}, {"word": "Михаил", "begin": 11.725, "end": 12.085}, {"word": "Аверьянович", "begin": 12.105, "end": 13.366}, {"word": "пришел", "begin": 13.406, "end": 13.827}, {"word": "после", "begin": 13.867, "end": 14.207}, {"word": "обеда,", "begin": 14.247, "end": 15.968}, {"word": "когда", "begin": 15.988, "end": 16.268}, {"word": "Андрей", "begin": 16.308, "end": 16.609}, {"word": "Ефимович", "begin": 16.669, "end": 17.189}, {"word": "лежал", "begin": 17.249, "end": 17.609}, {"word": "на", "begin": 17.649, "end": 17.729}, {"word": "диване.", "begin": 17.769, "end": 20.351}]}, {"text": "Случилось так, что в это же время явился и Хоботов с бромистым калием.", "begin": 20.391, "end": 26.736, "words": [{"word": "Случилось", "begin": 20.391, "end": 20.932}, {"word": "так,", "begin": 20.972, "end": 21.372}, {"word": "что", "begin": 21.452, "end": 21.712}, {"word": "в", "begin": 21.772, "end": 21.832}, {"word": "это", "begin": 21.852, "end": 22.053}, {"word": "же", "begin": 22.093, "end": 22.213}, {"word": "время", "begin": 22.253, "end": 22.633}, {"word": "явился", "begin": 22.713, "end": 23.173}, {"word": "и", "begin": 23.213, "end": 23.253}, {"word": "Хоботов", "begin": 23.354, "end": 23.914}, {"word": "с", "begin": 23.994, "end": 24.054}, {"word": "бромистым", "begin": 24.094, "end": 24.715}, {"word": "калием.", "begin": 24.795, "end": 26.736}]}, {"text": "Андрей Ефимович тяжело поднялся, сел и уперся обеими руками от дивана.", "begin": 26.776, "end": 32.26, "words": [{"word": "Андрей", "begin": 26.776, "end": 27.076}, {"word": "Ефимович", "begin": 27.136, "end": 27.577}, {"word": "тяжело", "begin": 27.617, "end": 27.997}, {"word": "поднялся,", "begin": 28.057, "end": 28.737}, {"word": "сел", "begin": 28.858, "end": 30.038}, {"word": "и", "begin": 30.078, "end": 30.118}, {"word": "уперся", "begin": 30.158, "end": 30.619}, {"word": "обеими", "begin": 30.659, "end": 31.059}, {"word": "руками", "begin": 31.099, "end": 31.519}, {"word": "от", "begin": 31.559, "end": 31.6}, {"word": "дивана.", "begin": 31.64, "end": 32.26}]}, {"text": "—", "begin": 33.748, "end": 33.788, "words": [{"word": "—", "begin": 33.748, "end": 33.788}]}, {"text": "А сегодня, дорогой мой, —", "begin": 33.808, "end": 35.389, "words": [{"word": "А", "begin": 33.808, "end": 33.828}, {"word": "сегодня,", "begin": 33.948, "end": 34.649}, {"word": "дорогой", "begin": 34.689, "end": 35.149}, {"word": "мой,", "begin": 35.189, "end": 35.349}, {"word": "—", "begin": 35.369, "end": 35.389}]}, {"text": "начал Михаил Аверьянчу, —", "begin": 35.409, "end": 36.85, "words": [{"word": "начал", "begin": 35.409, "end": 35.77}, {"word": "Михаил", "begin": 35.81, "end": 36.13}, {"word": "Аверьянчу,", "begin": 36.15, "end": 36.81}, {"word": "—", "begin": 36.83, "end": 36.85}]}, {"text": "у вас цвет лица гораздо лучше, чем вчера.", "begin": 36.87, "end": 39.853, "words": [{"word": "у", "begin": 36.87, "end": 36.93}, {"word": "вас", "begin": 36.97, "end": 37.351}, {"word": "цвет", "begin": 37.431, "end": 37.731}, {"word": "лица", "begin": 37.771, "end": 38.111}, {"word": "гораздо", "begin": 38.151, "end": 38.552}, {"word": "лучше,", "begin": 38.592, "end": 38.892}, {"word": "чем", "begin": 38.912, "end": 39.072}, {"word": "вчера.", "begin": 39.112, "end": 39.853}]}, {"text": "Да вы молодцом, ей-богу, молодцом.", "begin": 39.893, "end": 43.916, "words": [{"word": "Да", "begin": 39.893, "end": 39.973}, {"word": "вы", "begin": 40.013, "end": 40.133}, {"word": "молодцом,", "begin": 40.173, "end": 41.013}, {"word": "ей-богу,", "begin": 41.153, "end": 41.814}, {"word": "молодцом.", "begin": 41.854, "end": 43.916}]}, {"text": "—", "begin": 43.976, "end": 43.996, "words": [{"word": "—", "begin": 43.976, "end": 43.996}]}, {"text": "Пора, пора поправляться, —", "begin": 44.016, "end": 45.377, "words": [{"word": "Пора,", "begin": 44.016, "end": 44.356}, {"word": "пора", "begin": 44.396, "end": 44.636}, {"word": "поправляться,", "begin": 44.676, "end": 45.337}, {"word": "—", "begin": 45.357, "end": 45.377}]}, {"text": "коллега сказал, хобот и взевая.", "begin": 45.417, "end": 47.458, "words": [{"word": "коллега", "begin": 45.417, "end": 45.777}, {"word": "сказал,", "begin": 45.817, "end": 46.177}, {"word": "хобот", "begin": 46.237, "end": 46.497}, {"word": "и", "begin": 46.517, "end": 46.557}, {"word": "взевая.", "begin": 46.598, "end": 47.458}]}, {"text": "—", "begin": 47.478, "end": 47.498, "words": [{"word": "—", "begin": 47.478, "end": 47.498}]}, {"text": "Небось, вам самим надоела эта канитель?", "begin": 47.518, "end": 50.5, "words": [{"word": "Небось,", "begin": 47.518, "end": 47.858}, {"word": "вам", "begin": 47.898, "end": 48.059}, {"word": "самим", "begin": 48.119, "end": 48.479}, {"word": "надоела", "begin": 48.499, "end": 48.919}, {"word": "эта", "begin": 48.979, "end": 49.099}, {"word": "канитель?", "begin": 49.139, "end": 50.5}]}, {"text": "—", "begin": 50.56, "end": 50.58, "words": [{"word": "—", "begin": 50.56, "end": 50.58}]}, {"text": "И поправимся, —", "begin": 50.62, "end": 51.901, "words": [{"word": "И", "begin": 50.62, "end": 50.741}, {"word": "поправимся,", "begin": 50.821, "end": 51.861}, {"word": "—", "begin": 51.881, "end": 51.901}]}, {"text": "весело сказал Михаил Аверьянч, —", "begin": 51.921, "end": 53.723, "words": [{"word": "весело", "begin": 51.921, "end": 52.322}, {"word": "сказал", "begin": 52.362, "end": 52.702}, {"word": "Михаил", "begin": 52.742, "end": 53.102}, {"word": "Аверьянч,", "begin": 53.122, "end": 53.683}, {"word": "—", "begin": 53.703, "end": 53.723}]}, {"text": "еще лет сто жить будем.", "begin": 53.763, "end": 55.864, "words": [{"word": "еще", "begin": 53.763, "end": 54.043}, {"word": "лет", "begin": 54.083, "end": 54.283}, {"word": "сто", "begin": 54.403, "end": 54.724}, {"word": "жить", "begin": 54.804, "end": 55.024}, {"word": "будем.", "begin": 55.064, "end": 55.864}]}, {"text": "Так-то-с.", "begin": 55.924, "end": 56.385, "words": [{"word": "Так-то-с.", "begin": 55.924, "end": 56.385}]}, {"text": "«Сто, не сто, а на двадцать еще хватит», —", "begin": 58.019, "end": 60.481, "words": [{"word": "«Сто,", "begin": 58.019, "end": 58.499}, {"word": "не", "begin": 58.539, "end": 58.659}, {"word": "сто,", "begin": 58.74, "end": 59.02}, {"word": "а", "begin": 59.04, "end": 59.06}, {"word": "на", "begin": 59.08, "end": 59.18}, {"word": "двадцать", "begin": 59.22, "end": 59.66}, {"word": "еще", "begin": 59.7, "end": 59.9}, {"word": "хватит»,", "begin": 59.96, "end": 60.441}, {"word": "—", "begin": 60.461, "end": 60.481}]}, {"text": "утешал Хоботов.", "begin": 60.501, "end": 61.581, "words": [{"word": "утешал", "begin": 60.501, "end": 60.881}, {"word": "Хоботов.", "begin": 60.961, "end": 61.581}]}, {"text": "«Ничего, ничего, коллега, не унывайте.", "begin": 61.601, "end": 64.143, "words": [{"word": "«Ничего,", "begin": 61.601, "end": 62.002}, {"word": "ничего,", "begin": 62.042, "end": 62.362}, {"word": "коллега,", "begin": 62.402, "end": 62.722}, {"word": "не", "begin": 62.762, "end": 62.822}, {"word": "унывайте.", "begin": 62.862, "end": 64.143}]}, {"text": "Будет вам тень наводить».", "begin": 64.183, "end": 66.644, "words": [{"word": "Будет", "begin": 64.183, "end": 64.503}, {"word": "вам", "begin": 64.543, "end": 64.983}, {"word": "тень", "begin": 65.063, "end": 65.304}, {"word": "наводить».", "begin": 65.344, "end": 66.644}]}, {"text": "«Мы еще покажем себя», —", "begin": 66.664, "end": 68.706, "words": [{"word": "«Мы", "begin": 66.664, "end": 66.905}, {"word": "еще", "begin": 66.985, "end": 67.325}, {"word": "покажем", "begin": 67.385, "end": 68.185}, {"word": "себя»,", "begin": 68.285, "end": 68.666}, {"word": "—", "begin": 68.686, "end": 68.706}]}, {"text": "захохотал Михаил Аверьянович и похлопал друга по колену.", "begin": 68.726, "end": 72.348, "words": [{"word": "захохотал", "begin": 68.726, "end": 69.366}, {"word": "Михаил", "begin": 69.406, "end": 69.726}, {"word": "Аверьянович", "begin": 69.746, "end": 70.347}, {"word": "и", "begin": 70.387, "end": 70.427}, {"word": "похлопал", "begin": 70.467, "end": 70.947}, {"word": "друга", "begin": 70.987, "end": 71.307}, {"word": "по", "begin": 71.347, "end": 71.427}, {"word": "колену.", "begin": 71.487, "end": 72.348}]}, {"text": "«Мы еще покажем.", "begin": 72.368, "end": 73.829, "words": [{"word": "«Мы", "begin": 72.368, "end": 72.588}, {"word": "еще", "begin": 72.648, "end": 72.968}, {"word": "покажем.", "begin": 73.008, "end": 73.829}]}, {"text": "Будущим летом, бог даст, макнем на Кавказ и весь его верхом объедем.", "begin": 73.869, "end": 78.412, "words": [{"word": "Будущим", "begin": 73.869, "end": 74.309}, {"word": "летом,", "begin": 74.329, "end": 74.609}, {"word": "бог", "begin": 74.649, "end": 74.849}, {"word": "даст,", "begin": 74.869, "end": 75.15}, {"word": "макнем", "begin": 75.19, "end": 75.63}, {"word": "на", "begin": 75.67, "end": 75.75}, {"word": "Кавказ", "begin": 75.81, "end": 76.871}, {"word": "и", "begin": 76.911, "end": 76.951}, {"word": "весь", "begin": 77.011, "end": 77.251}, {"word": "его", "begin": 77.331, "end": 77.471}, {"word": "верхом", "begin": 77.511, "end": 77.911}, {"word": "объедем.", "begin": 77.931, "end": 78.412}]}, {"text": "Хоп-хоп-хоп!", "begin": 78.452, "end": 79.912, "words": [{"word": "Хоп-хоп-хоп!", "begin": 78.452, "end": 79.912}]}, {"text": "А с Кавказа вернемся, гляди, чего доброго, на свадьбе гулять будем».", "begin": 79.933, "end": 84.015, "words": [{"word": "А", "begin": 79.933, "end": 79.953}, {"word": "с", "begin": 80.033, "end": 80.053}, {"word": "Кавказа", "begin": 80.093, "end": 80.513}, {"word": "вернемся,", "begin": 80.533, "end": 81.013}, {"word": "гляди,", "begin": 81.073, "end": 81.333}, {"word": "чего", "begin": 81.353, "end": 81.533}, {"word": "доброго,", "begin": 81.574, "end": 81.954}, {"word": "на", "begin": 81.974, "end": 82.074}, {"word": "свадьбе", "begin": 82.154, "end": 82.674}, {"word": "гулять", "begin": 82.734, "end": 83.114}, {"word": "будем».", "begin": 83.174, "end": 84.015}]}, {"text": "Михаил Аверьянович лукаво подмигнул глазом.", "begin": 84.565, "end": 87.206, "words": [{"word": "Михаил", "begin": 84.565, "end": 84.845}, {"word": "Аверьянович", "begin": 84.865, "end": 85.365}, {"word": "лукаво", "begin": 85.405, "end": 85.746}, {"word": "подмигнул", "begin": 85.786, "end": 86.386}, {"word": "глазом.", "begin": 86.426, "end": 87.206}]}, {"text": "«Женим вас, дружка милого, женим!»", "begin": 87.226, "end": 92.808, "words": [{"word": "«Женим", "begin": 87.226, "end": 87.946}, {"word": "вас,", "begin": 88.006, "end": 88.227}, {"word": "дружка", "begin": 88.247, "end": 88.667}, {"word": "милого,", "begin": 88.747, "end": 89.147}, {"word": "женим!»", "begin": 89.267, "end": 92.808}]}, {"text": "Андрей Ефимович вдруг почувствовал, что накипь подходит к горлу, у него страшно забилось сердце.", "begin": 92.849, "end": 99.911, "words": [{"word": "Андрей", "begin": 92.849, "end": 93.169}, {"word": "Ефимович", "begin": 93.229, "end": 93.649}, {"word": "вдруг", "begin": 93.669, "end": 93.909}, {"word": "почувствовал,", "begin": 93.929, "end": 94.569}, {"word": "что", "begin": 94.629, "end": 94.789}, {"word": "накипь", "begin": 94.909, "end": 95.35}, {"word": "подходит", "begin": 95.49, "end": 96.09}, {"word": "к", "begin": 96.13, "end": 96.15}, {"word": "горлу,", "begin": 96.25, "end": 96.73}, {"word": "у", "begin": 96.75, "end": 96.79}, {"word": "него", "begin": 96.81, "end": 97.07}, {"word": "страшно", "begin": 97.19, "end": 97.711}, {"word": "забилось", "begin": 97.751, "end": 98.151}, {"word": "сердце.", "begin": 98.211, "end": 99.911}]}, {"text": "«Это пошло!»", "begin": 99.931, "end": 101.752, "words": [{"word": "«Это", "begin": 99.931, "end": 100.392}, {"word": "пошло!»", "begin": 100.692, "end": 101.752}]}, {"text": "—", "begin": 101.812, "end": 101.832, "words": [{"word": "—", "begin": 101.812, "end": 101.832}]}, {"text": "сказал он, быстро вставая и отходя к окну.", "begin": 101.872, "end": 104.733, "words": [{"word": "сказал", "begin": 101.872, "end": 102.232}, {"word": "он,", "begin": 102.272, "end": 102.413}, {"word": "быстро", "begin": 102.453, "end": 102.793}, {"word": "вставая", "begin": 102.813, "end": 103.213}, {"word": "и", "begin": 103.253, "end": 103.333}, {"word": "отходя", "begin": 103.373, "end": 103.733}, {"word": "к", "begin": 103.773, "end": 103.813}, {"word": "окну.", "begin": 103.853, "end": 104.733}]}, {"text": "«Неужели вы не понимаете, что говорите пошлости?»", "begin": 104.754, "end": 108.315, "words": [{"word": "«Неужели", "begin": 104.754, "end": 105.214}, {"word": "вы", "begin": 105.254, "end": 105.354}, {"word": "не", "begin": 105.394, "end": 105.494}, {"word": "понимаете,", "begin": 105.554, "end": 106.174}, {"word": "что", "begin": 106.214, "end": 106.394}, {"word": "говорите", "begin": 106.474, "end": 107.034}, {"word": "пошлости?»", "begin": 107.135, "end": 108.315}]}, {"text": "Он хотел продолжать мягко и вежливо, но против воли вдруг сжал кулаки и поднял их выше головы.", "begin": 110.113, "end": 116.858, "words": [{"word": "Он", "begin": 110.113, "end": 110.213}, {"word": "хотел", "begin": 110.253, "end": 110.593}, {"word": "продолжать", "begin": 110.653, "end": 111.194}, {"word": "мягко", "begin": 111.274, "end": 111.694}, {"word": "и", "begin": 111.714, "end": 111.754}, {"word": "вежливо,", "begin": 111.814, "end": 112.315}, {"word": "но", "begin": 112.355, "end": 112.455}, {"word": "против", "begin": 112.515, "end": 112.855}, {"word": "воли", "begin": 112.975, "end": 113.315}, {"word": "вдруг", "begin": 113.375, "end": 113.715}, {"word": "сжал", "begin": 113.735, "end": 114.156}, {"word": "кулаки", "begin": 114.196, "end": 114.716}, {"word": "и", "begin": 114.756, "end": 114.816}, {"word": "поднял", "begin": 114.896, "end": 115.256}, {"word": "их", "begin": 115.276, "end": 115.417}, {"word": "выше", "begin": 115.457, "end": 115.737}, {"word": "головы.", "begin": 115.797, "end": 116.858}]}, {"text": "—", "begin": 116.878, "end": 116.898, "words": [{"word": "—", "begin": 116.878, "end": 116.898}]}, {"text": "Оставьте меня!", "begin": 116.958, "end": 119.039, "words": [{"word": "Оставьте", "begin": 116.958, "end": 118.479}, {"word": "меня!", "begin": 118.559, "end": 119.039}]}, {"text": "—", "begin": 119.099, "end": 119.119, "words": [{"word": "—", "begin": 119.099, "end": 119.119}]}, {"text": "крикнул он не своим голосом, багровея и дрожа всем телом.", "begin": 119.159, "end": 122.762, "words": [{"word": "крикнул", "begin": 119.159, "end": 119.639}, {"word": "он", "begin": 119.679, "end": 119.759}, {"word": "не", "begin": 119.8, "end": 119.9}, {"word": "своим", "begin": 119.96, "end": 120.28}, {"word": "голосом,", "begin": 120.36, "end": 120.9}, {"word": "багровея", "begin": 120.98, "end": 121.581}, {"word": "и", "begin": 121.601, "end": 121.621}, {"word": "дрожа", "begin": 121.661, "end": 122.001}, {"word": "всем", "begin": 122.041, "end": 122.281}, {"word": "телом.", "begin": 122.361, "end": 122.762}]}, {"text": "—", "begin": 122.782, "end": 122.802, "words": [{"word": "—", "begin": 122.782, "end": 122.802}]}, {"text": "Вон!", "begin": 122.982, "end": 124.022, "words": [{"word": "Вон!", "begin": 122.982, "end": 124.022}]}, {"text": "Оба!", "begin": 124.082, "end": 124.663, "words": [{"word": "Оба!", "begin": 124.082, "end": 124.663}]}, {"text": "Вон!", "begin": 124.783, "end": 125.683, "words": [{"word": "Вон!", "begin": 124.783, "end": 125.683}]}, {"text": "Оба!", "begin": 125.744, "end": 128.505, "words": [{"word": "Оба!", "begin": 125.744, "end": 128.505}]}, {"text": "Михаил Аверьян, чехоботов, встали и уставились на него сначала с недоумением, потом со страхом.", "begin": 128.525, "end": 135.45, "words": [{"word": "Михаил", "begin": 128.525, "end": 128.866}, {"word": "Аверьян,", "begin": 128.886, "end": 129.346}, {"word": "чехоботов,", "begin": 129.386, "end": 129.966}, {"word": "встали", "begin": 129.986, "end": 130.427}, {"word": "и", "begin": 130.467, "end": 130.527}, {"word": "уставились", "begin": 130.567, "end": 131.087}, {"word": "на", "begin": 131.127, "end": 131.167}, {"word": "него", "begin": 131.207, "end": 131.387}, {"word": "сначала", "begin": 131.427, "end": 131.868}, {"word": "с", "begin": 131.908, "end": 131.948}, {"word": "недоумением,", "begin": 131.988, "end": 133.929}, {"word": "потом", "begin": 133.969, "end": 134.269}, {"word": "со", "begin": 134.309, "end": 134.409}, {"word": "страхом.", "begin": 134.489, "end": 135.45}]}, {"text": "—", "begin": 135.881, "end": 135.901, "words": [{"word": "—", "begin": 135.881, "end": 135.901}]}, {"text": "Оба вон!", "begin": 135.921, "end": 137.702, "words": [{"word": "Оба", "begin": 135.921, "end": 136.521}, {"word": "вон!", "begin": 136.742, "end": 137.702}]}, {"text": "—", "begin": 137.782, "end": 137.802, "words": [{"word": "—", "begin": 137.782, "end": 137.802}]}, {"text": "продолжал кричать Андрей Ефимович.", "begin": 137.822, "end": 139.703, "words": [{"word": "продолжал", "begin": 137.822, "end": 138.362}, {"word": "кричать", "begin": 138.422, "end": 138.823}, {"word": "Андрей", "begin": 138.863, "end": 139.183}, {"word": "Ефимович.", "begin": 139.223, "end": 139.703}]}, {"text": "—", "begin": 139.763, "end": 139.783, "words": [{"word": "—", "begin": 139.763, "end": 139.783}]}, {"text": "Тупые люди!", "begin": 139.883, "end": 141.404, "words": [{"word": "Тупые", "begin": 139.883, "end": 140.664}, {"word": "люди!", "begin": 140.724, "end": 141.404}]}, {"text": "Глупые люди!",