{"audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/palata-nomera-6/palata-nomera-6-ch01.mp3", "narrator": "audiobook", "stopAtEnd": true, "fragments": [{"text": "Непременно.", "begin": 7075.588, "end": 7080.873, "words": [{"word": "Непременно.", "begin": 7075.588, "end": 7080.873}]}, {"text": "Глава шестнадцатая Однажды Михаил Аверьянович пришел после обеда, когда Андрей Ефимович лежал на диване.", "begin": 7080.933, "end": 7094.978, "words": [{"word": "Глава", "begin": 7080.933, "end": 7081.193}, {"word": "шестнадцатая", "begin": 7081.213, "end": 7081.974}, {"word": "Однажды", "begin": 7084.931, "end": 7086.292}, {"word": "Михаил", "begin": 7086.352, "end": 7086.712}, {"word": "Аверьянович", "begin": 7086.732, "end": 7087.993}, {"word": "пришел", "begin": 7088.033, "end": 7088.454}, {"word": "после", "begin": 7088.494, "end": 7088.834}, {"word": "обеда,", "begin": 7088.874, "end": 7090.595}, {"word": "когда", "begin": 7090.615, "end": 7090.895}, {"word": "Андрей", "begin": 7090.935, "end": 7091.236}, {"word": "Ефимович", "begin": 7091.296, "end": 7091.816}, {"word": "лежал", "begin": 7091.876, "end": 7092.236}, {"word": "на", "begin": 7092.276, "end": 7092.356}, {"word": "диване.", "begin": 7092.396, "end": 7094.978}]}, {"text": "Случилось так, что в это же время явился и Хоботов с бромистым калием.", "begin": 7095.018, "end": 7101.363, "words": [{"word": "Случилось", "begin": 7095.018, "end": 7095.559}, {"word": "так,", "begin": 7095.599, "end": 7095.999}, {"word": "что", "begin": 7096.079, "end": 7096.339}, {"word": "в", "begin": 7096.399, "end": 7096.459}, {"word": "это", "begin": 7096.479, "end": 7096.68}, {"word": "же", "begin": 7096.72, "end": 7096.84}, {"word": "время", "begin": 7096.88, "end": 7097.26}, {"word": "явился", "begin": 7097.34, "end": 7097.8}, {"word": "и", "begin": 7097.84, "end": 7097.88}, {"word": "Хоботов", "begin": 7097.981, "end": 7098.541}, {"word": "с", "begin": 7098.621, "end": 7098.681}, {"word": "бромистым", "begin": 7098.721, "end": 7099.342}, {"word": "калием.", "begin": 7099.422, "end": 7101.363}]}, {"text": "Андрей Ефимович тяжело поднялся, сел и уперся обеими руками от дивана.", "begin": 7101.403, "end": 7106.887, "words": [{"word": "Андрей", "begin": 7101.403, "end": 7101.703}, {"word": "Ефимович", "begin": 7101.763, "end": 7102.204}, {"word": "тяжело", "begin": 7102.244, "end": 7102.624}, {"word": "поднялся,", "begin": 7102.684, "end": 7103.364}, {"word": "сел", "begin": 7103.485, "end": 7104.665}, {"word": "и", "begin": 7104.705, "end": 7104.745}, {"word": "уперся", "begin": 7104.785, "end": 7105.246}, {"word": "обеими", "begin": 7105.286, "end": 7105.686}, {"word": "руками", "begin": 7105.726, "end": 7106.146}, {"word": "от", "begin": 7106.186, "end": 7106.227}, {"word": "дивана.", "begin": 7106.267, "end": 7106.887}]}, {"text": "—", "begin": 7108.375, "end": 7108.415, "words": [{"word": "—", "begin": 7108.375, "end": 7108.415}]}, {"text": "А сегодня, дорогой мой, —", "begin": 7108.435, "end": 7110.016, "words": [{"word": "А", "begin": 7108.435, "end": 7108.455}, {"word": "сегодня,", "begin": 7108.575, "end": 7109.276}, {"word": "дорогой", "begin": 7109.316, "end": 7109.776}, {"word": "мой,", "begin": 7109.816, "end": 7109.976}, {"word": "—", "begin": 7109.996, "end": 7110.016}]}, {"text": "начал Михаил Аверьянчу, —", "begin": 7110.036, "end": 7111.477, "words": [{"word": "начал", "begin": 7110.036, "end": 7110.397}, {"word": "Михаил", "begin": 7110.437, "end": 7110.757}, {"word": "Аверьянчу,", "begin": 7110.777, "end": 7111.437}, {"word": "—", "begin": 7111.457, "end": 7111.477}]}, {"text": "у вас цвет лица гораздо лучше, чем вчера.", "begin": 7111.497, "end": 7114.48, "words": [{"word": "у", "begin": 7111.497, "end": 7111.557}, {"word": "вас", "begin": 7111.597, "end": 7111.978}, {"word": "цвет", "begin": 7112.058, "end": 7112.358}, {"word": "лица", "begin": 7112.398, "end": 7112.738}, {"word": "гораздо", "begin": 7112.778, "end": 7113.179}, {"word": "лучше,", "begin": 7113.219, "end": 7113.519}, {"word": "чем", "begin": 7113.539, "end": 7113.699}, {"word": "вчера.", "begin": 7113.739, "end": 7114.48}]}, {"text": "Да вы молодцом, ей-богу, молодцом.", "begin": 7114.52, "end": 7118.543, "words": [{"word": "Да", "begin": 7114.52, "end": 7114.6}, {"word": "вы", "begin": 7114.64, "end": 7114.76}, {"word": "молодцом,", "begin": 7114.8, "end": 7115.64}, {"word": "ей-богу,", "begin": 7115.78, "end": 7116.441}, {"word": "молодцом.", "begin": 7116.481, "end": 7118.543}]}, {"text": "—", "begin": 7118.603, "end": 7118.623, "words": [{"word": "—", "begin": 7118.603, "end": 7118.623}]}, {"text": "Пора, пора поправляться, —", "begin": 7118.643, "end": 7120.004, "words": [{"word": "Пора,", "begin": 7118.643, "end": 7118.983}, {"word": "пора", "begin": 7119.023, "end": 7119.263}, {"word": "поправляться,", "begin": 7119.303, "end": 7119.964}, {"word": "—", "begin": 7119.984, "end": 7120.004}]}, {"text": "коллега сказал, хобот и взевая.", "begin": 7120.044, "end": 7122.085, "words": [{"word": "коллега", "begin": 7120.044, "end": 7120.404}, {"word": "сказал,", "begin": 7120.444, "end": 7120.804}, {"word": "хобот", "begin": 7120.864, "end": 7121.124}, {"word": "и", "begin": 7121.144, "end": 7121.184}, {"word": "взевая.", "begin": 7121.225, "end": 7122.085}]}, {"text": "—", "begin": 7122.105, "end": 7122.125, "words": [{"word": "—", "begin": 7122.105, "end": 7122.125}]}, {"text": "Небось, вам самим надоела эта канитель?", "begin": 7122.145, "end": 7125.127, "words": [{"word": "Небось,", "begin": 7122.145, "end": 7122.485}, {"word": "вам", "begin": 7122.525, "end": 7122.686}, {"word": "самим", "begin": 7122.746, "end": 7123.106}, {"word": "надоела", "begin": 7123.126, "end": 7123.546}, {"word": "эта", "begin": 7123.606, "end": 7123.726}, {"word": "канитель?", "begin": 7123.766, "end": 7125.127}]}, {"text": "—", "begin": 7125.187, "end": 7125.207, "words": [{"word": "—", "begin": 7125.187, "end": 7125.207}]}, {"text": "И поправимся, —", "begin": 7125.247, "end": 7126.528, "words": [{"word": "И", "begin": 7125.247, "end": 7125.368}, {"word": "поправимся,", "begin": 7125.448, "end": 7126.488}, {"word": "—", "begin": 7126.508, "end": 7126.528}]}, {"text": "весело сказал Михаил Аверьянч, —", "begin": 7126.548, "end": 7128.35, "words": [{"word": "весело", "begin": 7126.548, "end": 7126.949}, {"word": "сказал", "begin": 7126.989, "end": 7127.329}, {"word": "Михаил", "begin": 7127.369, "end": 7127.729}, {"word": "Аверьянч,", "begin": 7127.749, "end": 7128.31}, {"word": "—", "begin": 7128.33, "end": 7128.35}]}, {"text": "еще лет сто жить будем.", "begin": 7128.39, "end": 7130.491, "words": [{"word": "еще", "begin": 7128.39, "end": 7128.67}, {"word": "лет", "begin": 7128.71, "end": 7128.91}, {"word": "сто", "begin": 7129.03, "end": 7129.351}, {"word": "жить", "begin": 7129.431, "end": 7129.651}, {"word": "будем.", "begin": 7129.691, "end": 7130.491}]}, {"text": "Так-то-с.", "begin": 7130.551, "end": 7131.012, "words": [{"word": "Так-то-с.", "begin": 7130.551, "end": 7131.012}]}, {"text": "«Сто, не сто, а на двадцать еще хватит», —", "begin": 7132.646, "end": 7135.108, "words": [{"word": "«Сто,", "begin": 7132.646, "end": 7133.126}, {"word": "не", "begin": 7133.166, "end": 7133.286}, {"word": "сто,", "begin": 7133.367, "end": 7133.647}, {"word": "а", "begin": 7133.667, "end": 7133.687}, {"word": "на", "begin": 7133.707, "end": 7133.807}, {"word": "двадцать", "begin": 7133.847, "end": 7134.287}, {"word": "еще", "begin": 7134.327, "end": 7134.527}, {"word": "хватит»,", "begin": 7134.587, "end": 7135.068}, {"word": "—", "begin": 7135.088, "end": 7135.108}]}, {"text": "утешал Хоботов.", "begin": 7135.128, "end": 7136.208, "words": [{"word": "утешал", "begin": 7135.128, "end": 7135.508}, {"word": "Хоботов.", "begin": 7135.588, "end": 7136.208}]}, {"text": "«Ничего, ничего, коллега, не унывайте.", "begin": 7136.228, "end": 7138.77, "words": [{"word": "«Ничего,", "begin": 7136.228, "end": 7136.629}, {"word": "ничего,", "begin": 7136.669, "end": 7136.989}, {"word": "коллега,", "begin": 7137.029, "end": 7137.349}, {"word": "не", "begin": 7137.389, "end": 7137.449}, {"word": "унывайте.", "begin": 7137.489, "end": 7138.77}]}, {"text": "Будет вам тень наводить».", "begin": 7138.81, "end": 7141.271, "words": [{"word": "Будет", "begin": 7138.81, "end": 7139.13}, {"word": "вам", "begin": 7139.17, "end": 7139.61}, {"word": "тень", "begin": 7139.69, "end": 7139.931}, {"word": "наводить».", "begin": 7139.971, "end": 7141.271}]}, {"text": "«Мы еще покажем себя», —", "begin": 7141.291, "end": 7143.333, "words": [{"word": "«Мы", "begin": 7141.291, "end": 7141.532}, {"word": "еще", "begin": 7141.612, "end": 7141.952}, {"word": "покажем", "begin": 7142.012, "end": 7142.812}, {"word": "себя»,", "begin": 7142.912, "end": 7143.293}, {"word": "—", "begin": 7143.313, "end": 7143.333}]}, {"text": "захохотал Михаил Аверьянович и похлопал друга по колену.", "begin": 7143.353, "end": 7146.975, "words": [{"word": "захохотал", "begin": 7143.353, "end": 7143.993}, {"word": "Михаил", "begin": 7144.033, "end": 7144.353}, {"word": "Аверьянович", "begin": 7144.373, "end": 7144.974}, {"word": "и", "begin": 7145.014, "end": 7145.054}, {"word": "похлопал", "begin": 7145.094, "end": 7145.574}, {"word": "друга", "begin": 7145.614, "end": 7145.934}, {"word": "по", "begin": 7145.974, "end": 7146.054}, {"word": "колену.", "begin": 7146.114, "end": 7146.975}]}, {"text": "«Мы еще покажем.", "begin": 7146.995, "end": 7148.456, "words": [{"word": "«Мы", "begin": 7146.995, "end": 7147.215}, {"word": "еще", "begin": 7147.275, "end": 7147.595}, {"word": "покажем.", "begin": 7147.635, "end": 7148.456}]}, {"text": "Будущим летом, бог даст, макнем на Кавказ и весь его верхом объедем.", "begin": 7148.496, "end": 7153.039, "words": [{"word": "Будущим", "begin": 7148.496, "end": 7148.936}, {"word": "летом,", "begin": 7148.956, "end": 7149.236}, {"word": "бог", "begin": 7149.276, "end": 7149.476}, {"word": "даст,", "begin": 7149.496, "end": 7149.777}, {"word": "макнем", "begin": 7149.817, "end": 7150.257}, {"word": "на", "begin": 7150.297, "end": 7150.377}, {"word": "Кавказ", "begin": 7150.437, "end": 7151.498}, {"word": "и", "begin": 7151.538, "end": 7151.578}, {"word": "весь", "begin": 7151.638, "end": 7151.878}, {"word": "его", "begin": 7151.958, "end": 7152.098}, {"word": "верхом", "begin": 7152.138, "end": 7152.538}, {"word": "объедем.", "begin": 7152.558, "end": 7153.039}]}, {"text": "Хоп-хоп-хоп!", "begin": 7153.079, "end": 7154.539, "words": [{"word": "Хоп-хоп-хоп!", "begin": 7153.079, "end": 7154.539}]}, {"text": "А с Кавказа вернемся, гляди, чего доброго, на свадьбе гулять будем».", "begin": 7154.56, "end": 7158.642, "words": [{"word": "А", "begin": 7154.56, "end": 7154.58}, {"word": "с", "begin": 7154.66, "end": 7154.68}, {"word": "Кавказа", "begin": 7154.72, "end": 7155.14}, {"word": "вернемся,", "begin": 7155.16, "end": 7155.64}, {"word": "гляди,", "begin": 7155.7, "end": 7155.96}, {"word": "чего", "begin": 7155.98, "end": 7156.16}, {"word": "доброго,", "begin": 7156.201, "end": 7156.581}, {"word": "на", "begin": 7156.601, "end": 7156.701}, {"word": "свадьбе", "begin": 7156.781, "end": 7157.301}, {"word": "гулять", "begin": 7157.361, "end": 7157.741}, {"word": "будем».", "begin": 7157.801, "end": 7158.642}]}, {"text": "Михаил Аверьянович лукаво подмигнул глазом.", "begin": 7159.192, "end": 7161.833, "words": [{"word": "Михаил", "begin": 7159.192, "end": 7159.472}, {"word": "Аверьянович", "begin": 7159.492, "end": 7159.992}, {"word": "лукаво", "begin": 7160.032, "end": 7160.373}, {"word": "подмигнул", "begin": 7160.413, "end": 7161.013}, {"word": "глазом.", "begin": 7161.053, "end": 7161.833}]}, {"text": "«Женим вас, дружка милого, женим!»", "begin": 7161.853, "end": 7167.435, "words": [{"word": "«Женим", "begin": 7161.853, "end": 7162.573}, {"word": "вас,", "begin": 7162.633, "end": 7162.854}, {"word": "дружка", "begin": 7162.874, "end": 7163.294}, {"word": "милого,", "begin": 7163.374, "end": 7163.774}, {"word": "женим!»", "begin": 7163.894, "end": 7167.435}]}, {"text": "Андрей Ефимович вдруг почувствовал, что накипь подходит к горлу, у него страшно забилось сердце.", "begin": 7167.476, "end": 7174.538, "words": [{"word": "Андрей", "begin": 7167.476, "end": 7167.796}, {"word": "Ефимович", "begin": 7167.856, "end": 7168.276}, {"word": "вдруг", "begin": 7168.296, "end": 7168.536}, {"word": "почувствовал,", "begin": 7168.556, "end": 7169.196}, {"word": "что", "begin": 7169.256, "end": 7169.416}, {"word": "накипь", "begin": 7169.536, "end": 7169.977}, {"word": "подходит", "begin": 7170.117, "end": 7170.717}, {"word": "к", "begin": 7170.757, "end": 7170.777}, {"word": "горлу,", "begin": 7170.877, "end": 7171.357}, {"word": "у", "begin": 7171.377, "end": 7171.417}, {"word": "него", "begin": 7171.437, "end": 7171.697}, {"word": "страшно", "begin": 7171.817, "end": 7172.338}, {"word": "забилось", "begin": 7172.378, "end": 7172.778}, {"word": "сердце.", "begin": 7172.838, "end": 7174.538}]}, {"text": "«Это пошло!»", "begin": 7174.558, "end": 7176.379, "words": [{"word": "«Это", "begin": 7174.558, "end": 7175.019}, {"word": "пошло!»", "begin": 7175.319, "end": 7176.379}]}, {"text": "—", "begin": 7176.439, "end": 7176.459, "words": [{"word": "—", "begin": 7176.439, "end": 7176.459}]}, {"text": "сказал он, быстро вставая и отходя к окну.", "begin": 7176.499, "end": 7179.36, "words": [{"word": "сказал", "begin": 7176.499, "end": 7176.859}, {"word": "он,", "begin": 7176.899, "end": 7177.04}, {"word": "быстро", "begin": 7177.08, "end": 7177.42}, {"word": "вставая", "begin": 7177.44, "end": 7177.84}, {"word": "и", "begin": 7177.88, "end": 7177.96}, {"word": "отходя", "begin": 7178.0, "end": 7178.36}, {"word": "к", "begin": 7178.4, "end": 7178.44}, {"word": "окну.", "begin": 7178.48, "end": 7179.36}]}, {"text": "«Неужели вы не понимаете, что говорите пошлости?»", "begin": 7179.381, "end": 7182.942, "words": [{"word": "«Неужели", "begin": 7179.381, "end": 7179.841}, {"word": "вы", "begin": 7179.881, "end": 7179.981}, {"word": "не", "begin": 7180.021, "end": 7180.121}, {"word": "понимаете,", "begin": 7180.181, "end": 7180.801}, {"word": "что", "begin": 7180.841, "end": 7181.021}, {"word": "говорите", "begin": 7181.101, "end": 7181.661}, {"word": "пошлости?»", "begin": 7181.762, "end": 7182.942}]}, {"text": "Он хотел продолжать мягко и вежливо, но против воли вдруг сжал кулаки и поднял их выше головы.", "begin": 7184.74, "end": 7191.485, "words": [{"word": "Он", "begin": 7184.74, "end": 7184.84}, {"word": "хотел", "begin": 7184.88, "end": 7185.22}, {"word": "продолжать", "begin": 7185.28, "end": 7185.821}, {"word": "мягко", "begin": 7185.901, "end": 7186.321}, {"word": "и", "begin": 7186.341, "end": 7186.381}, {"word": "вежливо,", "begin": 7186.441, "end": 7186.942}, {"word": "но", "begin": 7186.982, "end": 7187.082}, {"word": "против", "begin": 7187.142, "end": 7187.482}, {"word": "воли", "begin": 7187.602, "end": 7187.942}, {"word": "вдруг", "begin": 7188.002, "end": 7188.342}, {"word": "сжал", "begin": 7188.362, "end": 7188.783}, {"word": "кулаки", "begin": 7188.823, "end": 7189.343}, {"word": "и", "begin": 7189.383, "end": 7189.443}, {"word": "поднял", "begin": 7189.523, "end": 7189.883}, {"word": "их", "begin": 7189.903, "end": 7190.044}, {"word": "выше", "begin": 7190.084, "end": 7190.364}, {"word": "головы.", "begin": 7190.424, "end": 7191.485}]}, {"text": "—", "begin": 7191.505, "end": 7191.525, "words": [{"word": "—", "begin": 7191.505, "end": 7191.525}]}, {"text": "Оставьте меня!", "begin": 7191.585, "end": 7193.666, "words": [{"word": "Оставьте", "begin": 7191.585, "end": 7193.106}, {"word": "меня!", "begin": 7193.186, "end": 7193.666}]}, {"text": "—", "begin": 7193.726, "end": 7193.746, "words": [{"word": "—", "begin": 7193.726, "end": 7193.746}]}, {"text": "крикнул он не своим голосом, багровея и дрожа всем телом.", "begin": 7193.786, "end": 7197.389, "words": [{"word": "крикнул", "begin": 7193.786, "end": 7194.266}, {"word": "он", "begin": 7194.306, "end": 7194.386}, {"word": "не", "begin": 7194.427, "end": 7194.527}, {"word": "своим", "begin": 7194.587, "end": 7194.907}, {"word": "голосом,", "begin": 7194.987, "end": 7195.527}, {"word": "багровея", "begin": 7195.607, "end": 7196.208}, {"word": "и", "begin": 7196.228, "end": 7196.248}, {"word": "дрожа", "begin": 7196.288, "end": 7196.628}, {"word": "всем", "begin": 7196.668, "end": 7196.908}, {"word": "телом.", "begin": 7196.988, "end": 7197.389}]}, {"text": "—", "begin": 7197.409, "end": 7197.429, "words": [{"word": "—", "begin": 7197.409, "end": 7197.429}]}, {"text": "Вон!", "begin": 7197.609, "end": 7198.649, "words": [{"word": "Вон!", "begin": 7197.609, "end": 7198.649}]}, {"text": "Оба!", "begin": 7198.709, "end": 7199.29, "words": [{"word": "Оба!", "begin": 7198.709, "end": 7199.29}]}, {"text": "Вон!", "begin": 7199.41, "end": 7200.31, "words": [{"word": "Вон!", "begin": 7199.41, "end": 7200.31}]}, {"text": "Оба!", "begin": 7200.371, "end": 7203.132, "words": [{"word": "Оба!", "begin": 7200.371, "end": 7203.132}]}, {"text": "Михаил Аверьян, чехоботов, встали и уставились на него сначала с недоумением, потом со страхом.", "begin": 7203.152, "end": 7210.077, "words": [{"word": "Михаил", "begin": 7203.152, "end": 7203.493}, {"word": "Аверьян,", "begin": 7203.513, "end": 7203.973}, {"word": "чехоботов,", "begin": 7204.013, "end": 7204.593}, {"word": "встали", "begin": 7204.613, "end": 7205.054}, {"word": "и", "begin": 7205.094, "end": 7205.154}, {"word": "уставились", "begin": 7205.194, "end": 7205.714}, {"word": "на", "begin": 7205.754, "end": 7205.794}, {"word": "него", "begin": 7205.834, "end": 7206.014}, {"word": "сначала", "begin": 7206.054, "end": 7206.495}, {"word": "с", "begin": 7206.535, "end": 7206.575}, {"word": "недоумением,", "begin": 7206.615, "end": 7208.556}, {"word": "потом", "begin": 7208.596, "end": 7208.896}, {"word": "со", "begin": 7208.936, "end": 7209.036}, {"word": "страхом.", "begin": 7209.116, "end": 7