24.052, "end": 24.152}, {"word": "открытия", "begin": 24.192, "end": 24.713}, {"word": "Земской", "begin": 24.793, "end": 25.233}, {"word": "больницы.", "begin": 25.273, "end": 27.134}]}, {"text": "И на помощь Андрею Ефимовичу был приглашен городом уездный врач Евгений Федорович Хоботов.", "begin": 27.154, "end": 34.197, "words": [{"word": "И", "begin": 27.154, "end": 27.194}, {"word": "на", "begin": 27.214, "end": 27.314}, {"word": "помощь", "begin": 27.354, "end": 27.714}, {"word": "Андрею", "begin": 27.754, "end": 28.154}, {"word": "Ефимовичу", "begin": 28.214, "end": 28.775}, {"word": "был", "begin": 28.835, "end": 29.015}, {"word": "приглашен", "begin": 29.055, "end": 29.595}, {"word": "городом", "begin": 29.675, "end": 30.075}, {"word": "уездный", "begin": 30.115, "end": 30.595}, {"word": "врач", "begin": 30.635, "end": 31.076}, {"word": "Евгений", "begin": 31.176, "end": 31.696}, {"word": "Федорович", "begin": 31.776, "end": 32.276}, {"word": "Хоботов.", "begin": 32.356, "end": 34.197}]}, {"text": "Это еще очень молодой человек, ему нет и 30-ти, высокий брюнец с широкими скулами и маленькими глазками, вероятно, предки его были инородцами.", "begin": 34.217, "end": 44.202, "words": [{"word": "Это", "begin": 34.217, "end": 34.337}, {"word": "еще", "begin": 34.377, "end": 34.537}, {"word": "очень", "begin": 34.577, "end": 34.797}, {"word": "молодой", "begin": 34.838, "end": 35.218}, {"word": "человек,", "begin": 35.278, "end": 35.878}, {"word": "ему", "begin": 35.958, "end": 36.178}, {"word": "нет", "begin": 36.218, "end": 36.398}, {"word": "и", "begin": 36.438, "end": 36.478}, {"word": "30-ти,", "begin": 36.518, "end": 37.799}, {"word": "высокий", "begin": 37.839, "end": 38.279}, {"word": "брюнец", "begin": 38.339, "end": 38.919}, {"word": "с", "begin": 38.939, "end": 38.959}, {"word": "широкими", "begin": 39.0, "end": 39.48}, {"word": "скулами", "begin": 39.58, "end": 40.02}, {"word": "и", "begin": 40.04, "end": 40.08}, {"word": "маленькими", "begin": 40.12, "end": 40.64}, {"word": "глазками,", "begin": 40.7, "end": 42.041}, {"word": "вероятно,", "begin": 42.061, "end": 42.501}, {"word": "предки", "begin": 42.541, "end": 42.881}, {"word": "его", "begin": 42.941, "end": 43.081}, {"word": "были", "begin": 43.121, "end": 43.362}, {"word": "инородцами.", "begin": 43.382, "end": 44.202}]}, {"text": "Приехал он в город без гроша денег, с небольшим чемоданчиком и с молодой некрасивой женщиной, которую он называет своей кухаркой.", "begin": 45.201, "end": 54.287, "words": [{"word": "Приехал", "begin": 45.201, "end": 45.561}, {"word": "он", "begin": 45.601, "end": 45.701}, {"word": "в", "begin": 45.741, "end": 45.781}, {"word": "город", "begin": 45.821, "end": 46.102}, {"word": "без", "begin": 46.142, "end": 46.302}, {"word": "гроша", "begin": 46.342, "end": 46.702}, {"word": "денег,", "begin": 46.762, "end": 47.162}, {"word": "с", "begin": 47.182, "end": 47.222}, {"word": "небольшим", "begin": 47.262, "end": 47.683}, {"word": "чемоданчиком", "begin": 47.743, "end": 49.164}, {"word": "и", "begin": 49.204, "end": 49.244}, {"word": "с", "begin": 49.284, "end": 49.324}, {"word": "молодой", "begin": 49.364, "end": 49.724}, {"word": "некрасивой", "begin": 49.784, "end": 50.444}, {"word": "женщиной,", "begin": 50.544, "end": 51.085}, {"word": "которую", "begin": 51.125, "end": 51.465}, {"word": "он", "begin": 51.485, "end": 51.525}, {"word": "называет", "begin": 51.565, "end": 52.005}, {"word": "своей", "begin": 52.065, "end": 52.426}, {"word": "кухаркой.", "begin": 52.486, "end": 54.287}]}, {"text": "У этой женщины грудной младенец.", "begin": 54.327, "end": 58.229, "words": [{"word": "У", "begin": 54.327, "end": 54.367}, {"word": "этой", "begin": 54.387, "end": 54.607}, {"word": "женщины", "begin": 54.667, "end": 55.167}, {"word": "грудной", "begin": 55.228, "end": 55.628}, {"word": "младенец.", "begin": 55.668, "end": 58.229}]}, {"text": "Ходит Евгений Федорович в фуражке с козырьком и в высоких сапогах, а зимой в полушубке.", "begin": 58.29, "end": 64.273, "words": [{"word": "Ходит", "begin": 58.29, "end": 58.67}, {"word": "Евгений", "begin": 58.77, "end": 59.19}, {"word": "Федорович", "begin": 59.25, "end": 59.811}, {"word": "в", "begin": 59.831, "end": 59.911}, {"word": "фуражке", "begin": 59.991, "end": 60.511}, {"word": "с", "begin": 60.571, "end": 60.591}, {"word": "козырьком", "begin": 60.631, "end": 61.271}, {"word": "и", "begin": 61.311, "end": 61.352}, {"word": "в", "begin": 61.392, "end": 61.412}, {"word": "высоких", "begin": 61.452, "end": 61.952}, {"word": "сапогах,", "begin": 62.012, "end": 62.572}, {"word": "а", "begin": 62.592, "end": 62.632}, {"word": "зимой", "begin": 62.692, "end": 62.953}, {"word": "в", "begin": 62.993, "end": 63.033}, {"word": "полушубке.", "begin": 63.093, "end": 64.273}]}, {"text": "Он близко сошелся с фельдшером Сергеем Сергеевичем и с казначеем, а остальных чиновников называет почему-то аристократами и сторонится их.", "begin": 64.293, "end": 72.839, "words": [{"word": "Он", "begin": 64.293, "end": 64.434}, {"word": "близко", "begin": 64.494, "end": 64.854}, {"word": "сошелся", "begin": 64.894, "end": 65.454}, {"word": "с", "begin": 65.514, "end": 65.574}, {"word": "фельдшером", "begin": 65.634, "end": 66.095}, {"word": "Сергеем", "begin": 66.135, "end": 66.495}, {"word": "Сергеевичем", "begin": 66.535, "end": 67.235}, {"word": "и", "begin": 67.255, "end": 67.275}, {"word": "с", "begin": 67.335, "end": 67.355}, {"word": "казначеем,", "begin": 67.395, "end": 68.676}, {"word": "а", "begin": 68.696, "end": 68.756}, {"word": "остальных", "begin": 68.796, "end": 69.317}, {"word": "чиновников", "begin": 69.357, "end": 69.937}, {"word": "называет", "begin": 69.977, "end": 70.417}, {"word": "почему-то", "begin": 70.457, "end": 70.898}, {"word": "аристократами", "begin": 70.958, "end": 71.778}, {"word": "и", "begin": 71.798, "end": 71.838}, {"word": "сторонится", "begin": 71.898, "end": 72.499}, {"word": "их.", "begin": 72.599, "end": 72.839}]}, {"text": "Во всей квартире у него есть только одна книга «Новейшие рецепты венской клиники за 1881 год».", "begin": 74.026, "end": 82.613, "words": [{"word": "Во", "begin": 74.026, "end": 74.106}, {"word": "всей", "begin": 74.146, "end": 74.366}, {"word": "квартире", "begin": 74.406, "end": 74.947}, {"word": "у", "begin": 75.007, "end": 75.047}, {"word": "него", "begin": 75.087, "end": 75.287}, {"word": "есть", "begin": 75.347, "end": 75.487}, {"word": "только", "begin": 75.507, "end": 75.787}, {"word": "одна", "begin": 75.827, "end": 76.088}, {"word": "книга", "begin": 76.148, "end": 76.928}, {"word": "«Новейшие", "begin": 76.948, "end": 77.629}, {"word": "рецепты", "begin": 77.689, "end": 78.329}, {"word": "венской", "begin": 78.409, "end": 78.87}, {"word": "клиники", "begin": 78.91, "end": 79.53}, {"word": "за", "begin": 79.59, "end": 80.651}, {"word": "1881", "begin": 81.251, "end": 81.572}, {"word": "год».", "begin": 81.612, "end": 82.613}]}, {"text": "Идя к больному, он всегда берет с собой и эту книжку.", "begin": 82.653, "end": 86.455, "words": [{"word": "Идя", "begin": 82.653, "end": 82.833}, {"word": "к", "begin": 82.873, "end": 82.913}, {"word": "больному,", "begin": 82.953, "end": 83.393}, {"word": "он", "begin": 83.433, "end": 83.513}, {"word": "всегда", "begin": 83.553, "end": 83.873}, {"word": "берет", "begin": 83.934, "end": 84.194}, {"word": "с", "begin": 84.234, "end": 84.274}, {"word": "собой", "begin": 84.314, "end": 84.694}, {"word": "и", "begin": 84.734, "end": 84.794}, {"word": "эту", "begin": 84.854, "end": 85.034}, {"word": "книжку.", "begin": 85.074, "end": 86.455}]}, {"text": "В клубе по вечерам играет он в бильярд, карт же не любит.", "begin": 86.495, "end": 91.519, "words": [{"word": "В", "begin": 86.495, "end": 86.535}, {"word": "клубе", "begin": 86.576, "end": 86.936}, {"word": "по", "begin": 86.976, "end": 87.056}, {"word": "вечерам", "begin": 87.096, "end": 87.596}, {"word": "играет", "begin": 87.656, "end": 88.037}, {"word": "он", "begin": 88.077, "end": 88.197}, {"word": "в", "begin": 88.217, "end": 88.277}, {"word": "бильярд,", "begin": 88.337, "end": 89.378}, {"word": "карт", "begin": 89.438, "end": 89.818}, {"word": "же", "begin": 89.878, "end": 90.018}, {"word": "не", "begin": 90.078, "end": 90.218}, {"word": "любит.", "begin": 90.278, "end": 91.519}]}, {"text": "Большой охотник употреблять в разговоре такие слова, как «конетель», «мантифолия с уксусом», «будет тебе тень наводить»", "begin": 91.539, "end": 99.525, "words": [{"word": "Большой", "begin": 91.539, "end": 91.86}, {"word": "охотник", "begin": 91.9, "end": 92.52}, {"word": "употреблять", "begin": 92.56, "end": 93.14}, {"word": "в", "begin": 93.181, "end": 93.221}, {"word": "разговоре", "begin": 93.241, "end": 93.701}, {"word": "такие", "begin": 93.741, "end": 94.021}, {"word": "слова,", "begin": 94.061, "end": 94.361}, {"word": "как", "begin": 94.381, "end": 94.542}, {"word": "«конетель»,", "begin": 94.562, "end": 95.883}, {"word": "«мантифолия", "begin": 95.903, "end": 96.683}, {"word": "с", "begin": 96.743, "end": 96.783}, {"word": "уксусом»,", "begin": 96.803, "end": 97.784}, {"word": "«будет", "begin": 97.804, "end": 98.204}, {"word": "тебе", "begin": 98.264, "end": 98.505}, {"word": "тень", "begin": 98.645, "end": 98.965}, {"word": "наводить»", "begin": 99.005, "end": 99.525}]}, {"text": "и тому подобное.", "begin": 99.545, "end": 100.446, "words": [{"word": "и", "begin": 99.545, "end": 99.585}, {"word": "тому", "begin": 99.625, "end": 99.846}, {"word": "подобное.", "begin": 99.886, "end": 100.446}]}, {"text": "В больницу он бывает два раза в неделю, обходит палаты и делает приемку больных.", "begin": 101.671, "end": 107.756, "words": [{"word": "В", "begin": 101.671, "end": 101.711}, {"word": "больницу", "begin": 101.751, "end": 102.151}, {"word": "он", "begin": 102.171, "end": 102.251}, {"word": "бывает", "begin": 102.292, "end": 102.912}, {"word": "два", "begin": 102.992, "end": 103.152}, {"word": "раза", "begin": 103.192, "end": 103.432}, {"word": "в", "begin": 103.452, "end": 103.492}, {"word": "неделю,", "begin": 103.512, "end": 103.933}, {"word": "обходит", "begin": 103.973, "end": 104.373}, {"word": "палаты", "begin": 104.433, "end": 105.274}, {"word": "и", "begin": 105.314, "end": 105.334}, {"word": "делает", "begin": 105.374, "end": 105.714}, {"word": "приемку", "begin": 105.794, "end": 106.275}, {"word": "больных.", "begin": 106.315, "end": 107.756}]}, {"text": "Совершенное отсутствие антисептики и кровососные банки возмущают его, но новых порядков он не вводит, боясь оскорбить этим Андрея Ефимовича.", "begin": 107.776, "end": 118.064, "words": [{"word": "Совершенное", "begin": 107.776, "end": 108.416}, {"word": "отсутствие", "begin": 108.456, "end": 109.117}, {"word": "антисептики", "begin": 109.177, "end": 110.298}, {"word": "и", "begin": 110.318, "end": 110.338}, {"word": "кровососные", "begin": 110.378, "end": 111.078}, {"word": "банки", "begin": 111.138, "end": 111.479}, {"word": "возмущают", "begin": 111.519, "end": 112.279}, {"word": "его,", "begin": 112.379, "end": 113.06}, {"word": "но", "begin": 113.14, "end": 113.24}, {"word": "новых", "begin": 113.3, "end": 113.6}, {"word": "порядков", "begin": 113.64, "end": 114.141}, {"word": "он", "begin": 114.181, "end": 114.301}, {"word": "не", "begin": 114.341, "end": 114.461}, {"word": "вводит,", "begin": 114.481, "end": 115.001}, {"word": "боясь", "begin": 115.061, "end": 115.422}, {"word": "оскорбить", "begin": 115.462, "end": 115.942}, {"word": "этим", "begin": 115.982, "end": 116.202}, {"word": "Андрея", "begin": 116.222, "end": 116.583}, {"word": "Ефимовича.", "begin": 116.683, "end": 118.064}]}, {"text": "Своего коллегу Андрея Ефимовича он считает старым плутом, подозревает у него большие средства и втайне завидует ему.", "begin": 118.144, "end": 127.171, "words": [{"word": "Своего", "begin": 118.144, "end": 118.544}, {"word": "коллегу", "begin": 118.604, "end": 119.045}, {"word": "Андрея", "begin": 119.085, "end": 119.485}, {"word