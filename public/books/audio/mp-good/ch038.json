{"audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/mp/full.mp3", "narrator": "audiobook", "fragments": [{"text": "Леоново, Петушки.", "begin": 11819.799, "end": 11823.002, "words": [{"word": "Леоново,", "begin": 11819.799, "end": 11820.259}, {"word": "Петушки.", "begin": 11820.3, "end": 11823.002}]}, {"text": "Двери вагонов защелкали, потом загудели все громче и явственнее.", "begin": 11823.062, "end": 11827.026, "words": [{"word": "Двери", "begin": 11823.062, "end": 11823.342}, {"word": "вагонов", "begin": 11823.382, "end": 11823.743}, {"word": "защелкали,", "begin": 11823.783, "end": 11824.583}, {"word": "потом", "begin": 11824.603, "end": 11824.844}, {"word": "загудели", "begin": 11824.884, "end": 11825.384}, {"word": "все", "begin": 11825.424, "end": 11825.584}, {"word": "громче", "begin": 11825.624, "end": 11826.025}, {"word": "и", "begin": 11826.045, "end": 11826.065}, {"word": "явственнее.", "begin": 11826.145, "end": 11827.026}]}, {"text": "И вот влетел в мой вагон и пролетел вдоль вагона с поголубевшим от страха лицом тракторист Евтюшкин.", "begin": 11827.066, "end": 11833.712, "words": [{"word": "И", "begin": 11827.066, "end": 11827.106}, {"word": "вот", "begin": 11827.146, "end": 11827.326}, {"word": "влетел", "begin": 11827.386, "end": 11827.766}, {"word": "в", "begin": 11827.806, "end": 11827.846}, {"word": "мой", "begin": 11827.886, "end": 11828.046}, {"word": "вагон", "begin": 11828.107, "end": 11828.927}, {"word": "и", "begin": 11828.987, "end": 11829.027}, {"word": "пролетел", "begin": 11829.087, "end": 11829.568}, {"word": "вдоль", "begin": 11829.608, "end": 11829.868}, {"word": "вагона", "begin": 11829.908, "end": 11830.288}, {"word": "с", "begin": 11830.329, "end": 11830.369}, {"word": "поголубевшим", "begin": 11830.409, "end": 11831.089}, {"word": "от", "begin": 11831.129, "end": 11831.209}, {"word": "страха", "begin": 11831.249, "end": 11831.55}, {"word": "лицом", "begin": 11831.59, "end": 11831.89}, {"word": "тракторист", "begin": 11831.91, "end": 11832.49}, {"word": "Евтюшкин.", "begin": 11832.51, "end": 11833.712}]}, {"text": "А спустя десяток мгновений тем же путем ворвались полчища Ирины и устремились следом за ним.", "begin": 11833.732, "end": 11839.176, "words": [{"word": "А", "begin": 11833.732, "end": 11833.792}, {"word": "спустя", "begin": 11833.832, "end": 11834.172}, {"word": "десяток", "begin": 11834.192, "end": 11834.632}, {"word": "мгновений", "begin": 11834.692, "end": 11835.313}, {"word": "тем", "begin": 11835.353, "end": 11835.513}, {"word": "же", "begin": 11835.573, "end": 11835.653}, {"word": "путем", "begin": 11835.713, "end": 11836.014}, {"word": "ворвались", "begin": 11836.054, "end": 11836.474}, {"word": "полчища", "begin": 11836.534, "end": 11837.115}, {"word": "Ирины", "begin": 11837.135, "end": 11837.315}, {"word": "и", "begin": 11837.415, "end": 11837.475}, {"word": "устремились", "begin": 11837.515, "end": 11838.075}, {"word": "следом", "begin": 11838.095, "end": 11838.436}, {"word": "за", "begin": 11838.496, "end": 11838.596}, {"word": "ним.", "begin": 11838.636, "end": 11839.176}]}, {"text": "Гремели бубны и кимвалы.", "begin": 11839.237, "end": 11840.898, "words": [{"word": "Гремели", "begin": 11839.237, "end": 11839.657}, {"word": "бубны", "begin": 11839.717, "end": 11840.077}, {"word": "и", "begin": 11840.097, "end": 11840.177}, {"word": "кимвалы.", "begin": 11840.217, "end": 11840.898}]}, {"text": "Волосы мои встали дыбом.", "begin": 11841.38, "end": 11842.7, "words": [{"word": "Волосы", "begin": 11841.38, "end": 11841.74}, {"word": "мои", "begin": 11841.78, "end": 11841.94}, {"word": "встали", "begin": 11841.96, "end": 11842.34}, {"word": "дыбом.", "begin": 11842.38, "end": 11842.7}]}, {"text": "Не помня себя, я вскочил.", "begin": 11842.72, "end": 11844.041, "words": [{"word": "Не", "begin": 11842.72, "end": 11842.8}, {"word": "помня", "begin": 11842.84, "end": 11843.101}, {"word": "себя,", "begin": 11843.141, "end": 11843.401}, {"word": "я", "begin": 11843.441, "end": 11843.501}, {"word": "вскочил.", "begin": 11843.541, "end": 11844.041}]}, {"text": "Затолкнул ногами.", "begin": 11844.081, "end": 11844.961, "words": [{"word": "Затолкнул", "begin": 11844.081, "end": 11844.521}, {"word": "ногами.", "begin": 11844.581, "end": 11844.961}]}, {"text": "Остановитесь, девушки.", "begin": 11844.981, "end": 11847.042, "words": [{"word": "Остановитесь,", "begin": 11844.981, "end": 11845.681}, {"word": "девушки.", "begin": 11845.741, "end": 11847.042}]}, {"text": "Богини мщения, остановитесь, в мире нет виноватых.", "begin": 11847.082, "end": 11850.183, "words": [{"word": "Богини", "begin": 11847.082, "end": 11847.502}, {"word": "мщения,", "begin": 11847.542, "end": 11848.102}, {"word": "остановитесь,", "begin": 11848.142, "end": 11848.782}, {"word": "в", "begin": 11848.822, "end": 11848.882}, {"word": "мире", "begin": 11848.962, "end": 11849.162}, {"word": "нет", "begin": 11849.202, "end": 11849.403}, {"word": "виноватых.", "begin": 11849.463, "end": 11850.183}]}, {"text": "А они все бежали.", "begin": 11850.243, "end": 11851.943, "words": [{"word": "А", "begin": 11850.243, "end": 11850.303}, {"word": "они", "begin": 11850.343, "end": 11850.503}, {"word": "все", "begin": 11850.543, "end": 11850.743}, {"word": "бежали.", "begin": 11850.783, "end": 11851.943}]}, {"text": "И когда последняя со мной поравнялась, я закипел.", "begin": 11851.983, "end": 11854.464, "words": [{"word": "И", "begin": 11851.983, "end": 11852.023}, {"word": "когда", "begin": 11852.063, "end": 11852.263}, {"word": "последняя", "begin": 11852.303, "end": 11852.784}, {"word": "со", "begin": 11852.824, "end": 11852.924}, {"word": "мной", "begin": 11852.944, "end": 11853.104}, {"word": "поравнялась,", "begin": 11853.144, "end": 11853.764}, {"word": "я", "begin": 11853.824, "end": 11853.904}, {"word": "закипел.", "begin": 11853.944, "end": 11854.464}]}, {"text": "Я ухватил ее сзади.", "begin": 11854.524, "end": 11855.805, "words": [{"word": "Я", "begin": 11854.524, "end": 11854.604}, {"word": "ухватил", "begin": 11854.644, "end": 11855.104}, {"word": "ее", "begin": 11855.164, "end": 11855.284}, {"word": "сзади.", "begin": 11855.364, "end": 11855.805}]}, {"text": "Она задыхалась от бега.", "begin": 11855.845, "end": 11857.585, "words": [{"word": "Она", "begin": 11855.845, "end": 11856.005}, {"word": "задыхалась", "begin": 11856.045, "end": 11856.605}, {"word": "от", "begin": 11856.645, "end": 11856.765}, {"word": "бега.", "begin": 11856.845, "end": 11857.585}]}, {"text": "Куда вы, куда вы все бежите?", "begin": 11857.625, "end": 11859.726, "words": [{"word": "Куда", "begin": 11857.625, "end": 11857.925}, {"word": "вы,", "begin": 11857.965, "end": 11858.065}, {"word": "куда", "begin": 11858.085, "end": 11858.345}, {"word": "вы", "begin": 11858.365, "end": 11858.485}, {"word": "все", "begin": 11858.505, "end": 11858.745}, {"word": "бежите?", "begin": 11858.785, "end": 11859.726}]}, {"text": "Чего тебе, отвяжись, пусти.", "begin": 11859.766, "end": 11862.247, "words": [{"word": "Чего", "begin": 11859.766, "end": 11860.066}, {"word": "тебе,", "begin": 11860.126, "end": 11860.466}, {"word": "отвяжись,", "begin": 11860.486, "end": 11861.126}, {"word": "пусти.", "begin": 11861.166, "end": 11862.247}]}, {"text": "Куда и все мы едем, куда?", "begin": 11862.267, "end": 11864.747, "words": [{"word": "Куда", "begin": 11862.267, "end": 11862.607}, {"word": "и", "begin": 11862.647, "end": 11862.707}, {"word": "все", "begin": 11862.747, "end": 11863.007}, {"word": "мы", "begin": 11863.047, "end": 11863.167}, {"word": "едем,", "begin": 11863.267, "end": 11863.627}, {"word": "куда?", "begin": 11863.687, "end": 11864.747}]}, {"text": "Да тебе-то что за дело, бешеная?", "begin": 11864.787, "end": 11866.708, "words": [{"word": "Да", "begin": 11864.787, "end": 11864.867}, {"word": "тебе-то", "begin": 11864.907, "end": 11865.267}, {"word": "что", "begin": 11865.328, "end": 11865.528}, {"word": "за", "begin": 11865.568, "end": 11865.688}, {"word": "дело,", "begin": 11865.728, "end": 11866.028}, {"word": "бешеная?", "begin": 11866.088, "end": 11866.708}]}, {"text": "И вдруг повернулась ко мне, обхватила мою голову и поцеловала меня в лоб.", "begin": 11867.475, "end": 11871.258, "words": [{"word": "И", "begin": 11867.475, "end": 11867.515}, {"word": "вдруг", "begin": 11867.535, "end": 11867.795}, {"word": "повернулась", "begin": 11867.835, "end": 11868.436}, {"word": "ко", "begin": 11868.476, "end": 11868.556}, {"word": "мне,", "begin": 11868.596, "end": 11868.776}, {"word": "обхватила", "begin": 11868.796, "end": 11869.357}, {"word": "мою", "begin": 11869.397, "end": 11869.557}, {"word": "голову", "begin": 11869.637, "end": 11869.977}, {"word": "и", "begin": 11870.017, "end": 11870.057}, {"word": "поцеловала", "begin": 11870.097, "end": 11870.658}, {"word": "меня", "begin": 11870.718, "end": 11870.918}, {"word": "в", "begin": 11870.958, "end": 11870.998}, {"word": "лоб.", "begin": 11871.058, "end": 11871.258}]}, {"text": "До того неожиданно, что я засмущался, присел и стал грызть подсолнух.", "begin": 11871.278, "end": 11875.722, "words": [{"word": "До", "begin": 11871.278, "end": 11871.358}, {"word": "того", "begin": 11871.398, "end": 11871.579}, {"word": "неожиданно,", "begin": 11871.639, "end": 11872.119}, {"word": "что", "begin": 11872.159, "end": 11872.279}, {"word": "я", "begin": 11872.319, "end": 11872.359}, {"word": "засмущался,", "begin": 11872.399, "end": 11873.18}, {"word": "присел", "begin": 11873.24, "end": 11873.64}, {"word": "и", "begin": 11873.66, "end": 11873.7}, {"word": "стал", "begin": 11873.74, "end": 11873.941}, {"word": "грызть", "begin": 11873.981, "end": 11874.221}, {"word": "подсолнух.", "begin": 11874.241, "end": 11875.722}]}, {"text": "А покуда я грыз подсолнух, она отбежала немного, взглянула на меня, вернулась и съездила меня по левой щеке.", "begin": 11875.762, "end": 11882.348, "words": [{"word": "А", "begin": 11875.762, "end": 11875.822}, {"word": "покуда", "begin": 11875.862, "end": 11876.182}, {"word": "я", "begin": 11876.222, "end": 11876.262}, {"word": "грыз", "begin": 11876.283, "end": 11876.543}, {"word": "подсолнух,", "begin": 11876.583, "end": 11877.544}, {"word": "она", "begin": 11877.564, "end": 11877.744}, {"word": "отбежала", "begin": 11877.784, "end": 11878.244}, {"word": "немного,", "begin": 11878.284, "end": 11878.705}, {"word": "взглянула", "begin": 11878.745, "end": 11879.285}, {"word": "на", "begin": 11879.325, "end": 11879.385}, {"word": "меня,", "begin": 11879.405, "end": 11879.625}, {"word": "вернулась", "begin": 11879.705, "end": 11880.246}, {"word": "и", "begin": 11880.306, "end": 11880.346}, {"word": "съездила", "begin": 11880.406, "end": 11880.966}, {"word": "меня", "begin": 11880.986, "end": 11881.147}, {"word": "по", "begin": 11881.187, "end": 11881.247}, {"word": "левой", "begin": 11881.287, "end": 11881.607}, {"word": "щеке.", "begin": 11881.687, "end": 11882.348}]}, {"text": "Съездила, взвилась к потолку и ринулась догонять подруг.", "begin": 11882.388, "end": 11886.111, "words": [{"word": "Съездила,", "begin": 11882.388, "end": 11883.008}, {"word": "взвилась", "begin": 11883.028, "end": 11883.509}, {"word": "к", "begin": 11883.529, "end": 11883.549}, {"word": "потолку", "begin": 11883.609, "end": 11884.089}, {"word": "и", "begin": 11884.149, "end": 11884.169}, {"word": "ринулась", "begin": 11884.229, "end": 11884.63}, {"word": "догонять", "begin": 11884.67, "end": 11885.07}, {"word": "подруг.", "begin": 11885.11, "end": 11886.111}]}, {"text": "Я бросился следом за ней, преступно выгибая шею.", "begin": 11886.191, "end": 11889.594, "words": [{"word": "Я", "begin": 11886.191, "end": 11886.271}, {"word": "бросился", "begin": 11886.331, "end": 11886.771}, {"word": "следом", "begin": 11886.851, "end": 11887.232}, {"word": "за", "begin": 11887.272, "end": 11887.372}, {"word": "ней,", "begin": 11887.412, "end": 11887.572}, {"word": "преступно", "begin": 11887.612, "end": 11888.193}, {"word": "выгибая", "begin": 11888.213, "end": 11888.673}, {"word": "шею.", "begin": 11888.773, "end": 11889.594}]}, {"text": "Пламенел закат, лошади вздрагивали.", "begin": 11889.634, "end": 11892.376, "words": [{"word": "Пламенел", "begin": 11889.634, "end": 11890.134}, {"word": "закат,", "begin": 11890.194, "end": 11890.635}, {"word": "лошади", "begin": 11890.695, "end": 11891.075}, {"word": "вздрагивали.", "begin": 11891.115, "end": 11892.376}]}, {"text": "И где то счастье, о котором пишут в газетах?", "begin": 11892.416, "end": 11894.678, "words": [{"word": "И", "begin": 11892.416, "end": 11892.456}, {"word": "где", "begin": 11892.516, "end": 11892.676}, {"word": "то", "begin": 11892.716, "end": 11892.836}, {"word": "счастье,", "begin": 11892.876, "end": 11893.397}, {"word": "о", "begin": 11893.417, "end": 11893.437}, {"word": "котором", "begin": 11893.457, "end": 11893.777}, {"word": "пишут", "begin": 11893.817, "end": 11894.098}, {"word": "в", "begin": 11894.118, "end": 11894.138}, {"word": "газетах?", "begin": 11894.198, "end": 11894.678}]}, {"text": "Я бежал и бежал сквозь вихорь и мрак, срывая двери с петель.", "begin": 11895.176, "end": 11898.697, "words": [{"word": "Я", "begin": 11895.176, "end": 11895.256}, {"word": "бежал", "begin": 11895.296, "end": 11895.636}, {"word": "и", "begin": 11895.656, "end": 11895.676}, {"word": "бежал", "begin": 11895.716, "end": 11896.016}, {"word": "сквозь", "begin": 11896.056, "end": 11896.356}, {"word": "вихорь", "begin": 11896.376, "end": 11896.656}, {"word": "и", "begin": 11896.696, "end": 11896.736}, {"word": "мрак,", "begin": 11896.776, "end": 11897.056}, {"word": "срывая", "begin": 11897.076, "end": 11897.436}, {"word": "двери", "begin": 11897.476, "end": 11897.716}, {"word": "с", "begin": 11897.776, "end": 11897.837}, {"word": "петель.", "begin": 11897.897, "end": 11898.697}]}, {"text": "Я знал, что поезд Москва-Петушки летит под откос.", "begin": 11898.757, "end": 11901.737, "words": [{"word": "Я", "begin": 11898.757, "end": 11898.837}, {"word": "знал,", "begin": 11898.897, "end": 11899.117}, {"word": "что", "begin": 11899.157, "end": 11899.297}, {"word": "поезд", "begin": 11899.337, "end": 11899.597}, {"word": "Москва-Петушки", "begin": 11899.637, "end": 11900.397}, {"word": "летит", "begin": 11900.437, "end": 11900.697}, {"word": "под", "begin": 11900.737, "end": 11900.877}, {"word": "откос.", "begin": 11900.897, "end": 11901.737}]}, {"text": "Вздымались вагоны и снова проваливались, как одержимые одурью.", "begin": 11901.777, "end": 11905.658, "words": [{"word": "Вздымались", "begin": 11901.777, "end": 11902.357}, {"word": "вагоны", "begin": 11902.397, "end": 11902.797}, {"word": "и", "begin": 11902.837, "end": 11902.857}, {"word": "снова", "begin": 11902.917, "end": 11903.177}, {"word": "проваливались,", "begin": 11903.237, "end": 11903.918}, {"word": "как", "begin": 11903.938, "end": 11904.098}, {"word": "одержимые", "begin": 11904.118, "end": 11904.758}, {"word": "одурью.", "begin": 11904.818, "end": 11905.658}]}, {"text": "И тогда я заметался и крикнул, «О, постойте!» Крикнул и оторопел.", "begin": 11905.698, "end": 11912.819, "words": [{"word": "И", "begin": 11905.698, "end": 11905.718}, {"word": "тогда", "begin": 11905.758, "end": 11905.998}, {"word": "я", "begin": 11906.058, "end": 11906.098}, {"word": "заметался", "begin": 11906.158, "end": 11908.058}, {"word": "и", "begin": 11908.118, "end": 11908.138}, {"word": "крикнул,", "begin": 11908.178, "end": 11908.578}, {"word": "«О,", "begin": 11908.598, "end": 11908.838}, {"word": "постойте!»", "begin": 11908.898, "end": 11910.699}, {"word": "Крикнул", "begin": 11910.739, "end": 11911.179}, {"word": "и", "begin": 11911.219, "end": 11911.259}, {"word": "оторопел.", "begin": 11911.299, "end": 11912.819}]}, {"text": "Хор Ирини бежал обратно со стороны головного вагона прямо на меня паническим стадом.", "begin": 11912.859, "end": 11917.54, "words": [{"word": "Хор", "begin": 11912.859, "end": 11913.079}, {"word": "Ирини", "begin": 11913.099, "end": 11913.439}, {"word": "бежал", "begin": 11913.539, "end": 11913.859}, {"word": "обратно", "begin": 11913.879, "end": 11914.259}, {"word": "со", "begin": 11914.299, "end": 11914.399}, {"word": "стороны", "begin": 11914.439, "end": 11914.74}, {"word": "головного", "begin": 11914.78, "end": 11915.2}, {"word": "вагона", "begin": 11915.24, "end": 11915.62}, {"word": "прямо", "begin": 11915.66, "end": 11915.92}, {"word": "на", "begin": 11915.94, "end": 11916.02}, {"word": "меня", "begin": 11916.04, "end": 11916.26}, {"word": "паническим", "begin": 11916.3, "end": 11916.92}, {"word": "стадом.", "begin": 11916.98, "end": 11917.54}]}, {"text": "За ним следом гнался разъяренный Евтюшкин.", "begin": 11917.58, "end": 11919.98, "words": [{"word": "За", "begin": 11917.58, "end": 11917.68}, {"word": "ним", "begin": 11917.7, "end": 11917.84}, {"word": "следом", "begin": 11917.9, "end": 11918.24}, {"word": "гнался", "begin": 11918.28, "end": 11918.66}, {"word": "разъяренный", "begin": 11918.7, "end": 11919.28}, {"word": "Евтюшкин.", "begin": 11919.34, "end": 11919.98}]}, {"text": "Вся эта лавина опрокинула меня и погребла под собой.", "begin": 11920.0, "end": 11922.961, "words": [{"word": "Вся", "begin": 11920.0, "end": 11920.221}, {"word": "эта", "begin": 11920.241, "end": 11920.381}, {"word": "лавина", "begin": 11920.421, "end": 11920.801}, {"word": "опрокинула", "begin": 11920.821, "end": 11921.421}, {"word": "меня", "begin": 11921.461, "end": 11921.701}, {"word": "и", "begin": 11921.721, "end": 11921.761}, {"word": "погребла", "begin": 11921.781, "end": 11922.261}, {"word": "под", "begin": 11922.281, "end": 11922.441}, {"word": "собой.", "begin": 11922.521, "end": 11922.961}]}, {"text": "А кимвалы продолжали бретать, а бубны гремели, и звезды падали на крыльцо сельсовета, и хохотала Сулами.", "begin": 11923.497, "end": 11932.804, "words": [{"word": "А", "begin": 11923.497, "end": 11923.557}, {"word": "кимвалы", "begin": 11923.597, "end": 11924.118}, {"word": "продолжали", "begin