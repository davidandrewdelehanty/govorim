{
  "audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/sobachye-serdtse/sobachye-serdtse-ch05.mp3",
  "narrator": "audiobook",
  "fragments": [
    {
      "text": "Глава пятая.",
      "begin": 1.357,
      "end": 3.4
    },
    {
      "text": "Из дневника доктора Барменталя.",
      "begin": 3.26,
      "end": 7.646
    },
    {
      "text": "Тонкая в пище лист форматом «Тетрадь».",
      "begin": 7.165,
      "end": 11.271
    },
    {
      "text": "Исписана почерком Барменталя.",
      "begin": 10.75,
      "end": 13.795
    },
    {
      "text": "На первых двух страницах он аккуратен, уборист и четок.",
      "begin": 13.695,
      "end": 19.22
    },
    {
      "text": "В дальнейшем размашист, взволнован, с большим количеством клякс.",
      "begin": 19.18,
      "end": 25.743
    },
    {
      "text": "22 декабря 1924 года.",
      "begin": 25.402,
      "end": 30.344
    },
    {
      "text": "Понедельник.",
      "begin": 29.124,
      "end": 30.825
    },
    {
      "text": "История болезни.",
      "begin": 30.404,
      "end": 33.146
    },
    {
      "text": "Лабораторная собака примерно двух лет от роду.",
      "begin": 32.445,
      "end": 37.247
    },
    {
      "text": "Самец.",
      "begin": 36.047,
      "end": 38.588
    },
    {
      "text": "Порода дворняжка.",
      "begin": 37.287,
      "end": 40.648
    },
    {
      "text": "Кличка Шарик.",
      "begin": 39.868,
      "end": 42.549
    },
    {
      "text": "Шерсть жидкая, кустами, буроватая, с подпаленными.",
      "begin": 42.089,
      "end": 47.771
    },
    {
      "text": "Хвост цвета топленого молока.",
      "begin": 47.151,
      "end": 50.232
    },
    {
      "text": "На правом боку следы совершенно зажившего ожога.",
      "begin": 50.132,
      "end": 55.355
    },
    {
      "text": "Питание до поступления к профессору плохое.",
      "begin": 54.794,
      "end": 58.736
    },
    {
      "text": "После недельного пребывания крайне упитанный.",
      "begin": 58.396,
      "end": 63.358
    },
    {
      "text": "Вес 8 килограммов.",
      "begin": 62.818,
      "end": 65.499
    },
    {
      "text": "Знак восклицательный.",
      "begin": 65.259,
      "end": 67.66
    },
    {
      "text": "Сердце легкие, желудок температура.",
      "begin": 67.18,
      "end": 71.568
    },
    {
      "text": "23 декабря.",
      "begin": 71.248,
      "end": 74.19
    },
    {
      "text": "В 8.30 часов вечера произведена первая в Европе операция по профессору Преображенскому.",
      "begin": 73.79,
      "end": 81.114
    },
    {
      "text": "Под хлороформенным наркозом удалены яички шарика и вместо них пересажены мужские яички с придатками и семенными канатиками, взятые от скончавшегося за 4 часа 4 минуты до операции мужчины 28 лет и сохранившиеся в стерилизованной физиологической жидкости по профессору Преображенскому.",
      "begin": 80.954,
      "end": 107.635
    },
    {
      "text": "Непосредственно вслед за сим удален после трепанации черепной крышки придаток мозга гипофиз и заменен человеческим от вышеуказанного мужчины.",
      "begin": 106.854,
      "end": 119.82
    },
    {
      "text": "Введено 8 кубиков хлороформа, 1 шприц камфоры, 2 шприца адреналина в сердце.",
      "begin": 119.359,
      "end": 127.675
    },
    {
      "text": "Показания к операции.",
      "begin": 127.074,
      "end": 129.379
    },
    {
      "text": "Постановка опыта Преображенского.",
      "begin": 128.737,
      "end": 131.53
    },
    {
      "text": "с комбинированной пересадкой гипофиза и яичек для выяснения вопроса о приживаемости гипофиза, а в дальнейшем и о его влиянии на омоложение организма у людей.",
      "begin": 131.51,
      "end": 146.859
    },
    {
      "text": "Оперировал профессор Филипп Филиппович Преображенский, ассистировал доктор Иван Арнольдович Барменталь.",
      "begin": 146.238,
      "end": 153.843
    },
    {
      "text": "В ночь после операции Грозные повторные падения пульса.",
      "begin": 153.783,
      "end": 159.654
    },
    {
      "text": "Ожидание смертельного исхода.",
      "begin": 159.074,
      "end": 162.155
    },
    {
      "text": "Громадные дозы камфоры по Преображенскому.",
      "begin": 161.535,
      "end": 167.236
    },
    {
      "text": "24 декабря.",
      "begin": 166.756,
      "end": 168.917
    },
    {
      "text": "Утром улучшение.",
      "begin": 168.276,
      "end": 170.837
    },
    {
      "text": "Дыхание учащено вдвое.",
      "begin": 170.337,
      "end": 173.278
    },
    {
      "text": "Температура 42.",
      "begin": 172.578,
      "end": 175.899
    },
    {
      "text": "Камфора, кофеин под кожу.",
      "begin": 174.938,
      "end": 178.8
    },
    {
      "text": "25 декабря.",
      "begin": 178.46,
      "end": 180.502
    },
    {
      "text": "Вновь ухудшение.",
      "begin": 180.181,
      "end": 182.243
    },
    {
      "text": "Пульс еле прощупывается, похолодание конечностей, зрачки не реагируют.",
      "begin": 181.903,
      "end": 188.787
    },
    {
      "text": "Адреналин в сердце, камфора по-преображенскому.",
      "begin": 188.187,
      "end": 193.591
    },
    {
      "text": "Физиологический раствор в вену.",
      "begin": 192.69,
      "end": 196.667
    },
    {
      "text": "26 декабря.",
      "begin": 196.427,
      "end": 199.008
    },
    {
      "text": "Некоторые улучшения.",
      "begin": 198.387,
      "end": 201.088
    },
    {
      "text": "Пульс 180, дыхание 92, температура 41.",
      "begin": 200.548,
      "end": 207.35
    },
    {
      "text": "Камфора, питание клизмами.",
      "begin": 206.409,
      "end": 210.63
    },
    {
      "text": "27 декабря.",
      "begin": 210.25,
      "end": 212.931
    },
    {
      "text": "Пульс 152, дыхание 50, температура 39,8, зрачки реагируют.",
      "begin": 212.391,
      "end": 220.853
    },
    {
      "text": "Камфора под кожу.",
      "begin": 220.373,
      "end": 223.245
    },
    {
      "text": "28 декабря.",
      "begin": 223.105,
      "end": 225.346
    },
    {
      "text": "Значительное улучшение.",
      "begin": 224.646,
      "end": 226.487
    },
    {
      "text": "В полдень внезапный проливной пот, температура 37,0.",
      "begin": 226.467,
      "end": 232.489
    },
    {
      "text": "Операционные раны в прежнем состоянии.",
      "begin": 231.729,
      "end": 236.591
    },
    {
      "text": "Перевязка.",
      "begin": 235.111,
      "end": 237.192
    },
    {
      "text": "Появился аппетит, питание жидкое.",
      "begin": 236.611,
      "end": 241.574
    },
    {
      "text": "29 декабря.",
      "begin": 241.234,
      "end": 244.015
    },
    {
      "text": "Внезапно обнаружено выпадение шерсти на лбу и на боках туловища.",
      "begin": 243.455,
      "end": 249.421
    },
    {
      "text": "Вызваны для консультации профессор по кафедре кожных болезней Василий Васильевич Бундарев, И директор Московского ветеринарного показательного института.",
      "begin": 248.939,
      "end": 260.024
    },
    {
      "text": "Имя случай признан неописанным в литературе.",
      "begin": 259.784,
      "end": 264.487
    },
    {
      "text": "Диагностика осталась неустановленной.",
      "begin": 263.727,
      "end": 267.47
    },
    {
      "text": "Температура нормальная.",
      "begin": 266.389,
      "end": 269.571
    },
    {
      "text": "Запись карандашом.",
      "begin": 269.231,
      "end": 272.133
    },
    {
      "text": "Вечером появился первый лай в 8 часов 15 минут.",
      "begin": 271.453,
      "end": 276.857
    },
    {
      "text": "Обращает внимание резкое изменение тембра и понижение тона.",
      "begin": 276.377,
      "end": 282.121
    },
    {
      "text": "«Вай»",
      "begin": 281.821,
      "end": 282.521
    },
    {
      "text": "вместо слова «гау-гау»",
      "begin": 282.141,
      "end": 284.262
    },
    {
      "text": "на слоге «а-о»",
      "begin": 284.182,
      "end": 286.623
    },
    {
      "text": "по окраске отдаленно напоминает стон.",
      "begin": 286.523,
      "end": 291.645
    },
    {
      "text": "30 декабря.",
      "begin": 291.305,
      "end": 293.946
    },
    {
      "text": "Выпадение шерсти приняло характер общего облысения.",
      "begin": 293.386,
      "end": 299.068
    },
    {
      "text": "Взвешивание дало неожиданный результат.",
      "begin": 298.288,
      "end": 301.569
    },
    {
      "text": "Вес 30 килограммов.",
      "begin": 301.269,
      "end": 303.73
    },
    {
      "text": "За счет роста, удлинения, костей.",
      "begin": 303.65,
      "end": 307.612
    },
    {
      "text": "Пес по-прежнему лежит.",
      "begin": 307.331,
      "end": 310.586
    },
    {
      "text": "31 декабря.",
      "begin": 310.266,
      "end": 313.467
    },
    {
      "text": "Колоссальный аппетит.",
      "begin": 312.707,
      "end": 314.968
    },
    {
      "text": "В тетради клякса, после кляксы, торопливым почерком.",
      "begin": 314.948,
      "end": 319.51
    },
    {
      "text": "В 12 часов 12 минут дня пёс отчётливо пролаял «Аб-быр».",
      "begin": 319.47,
      "end": 327.193
    },
    {
      "text": "В тетради перерыв и дальше, очевидно, по ошибке от волнения написано.",
      "begin": 327.173,
      "end": 333.871
    },
    {
      "text": "1 декабря.",
      "begin": 333.49,
      "end": 336.696
    },
    {
      "text": "Перечеркнуто.",
      "begin": 335.394,
      "end": 338.419
    },
    {
      "text": "Поправлено.",
      "begin": 336.736,
      "end": 338.46
    },
    {
      "text": "1 января 1925 года.",
      "begin": 338.44,
      "end": 342.607
    },
    {
      "text": "Фотографирован утром.",
      "begin": 341.505,
      "end": 344.391
    },
    {
      "text": "Отчетливо лает Абыр.",
      "begin": 343.75,
      "end": 346.607
    },
    {
      "text": "повторяя это слово громко и как бы радостно.",
      "begin": 346.107,
      "end": 350.13
    },
    {
      "text": "В три часа дня крупными буквами засмеялся, вызвав обморок горничной Зины.",
      "begin": 350.09,
      "end": 358.236
    },
    {
      "text": "Вечером произнес восемь раз подряд слово «Абырвалг», «Абыр»",
      "begin": 357.775,
      "end": 364.34
    },
    {
      "text": "косыми буквами карандашом.",
      "begin": 363.94,
      "end": 367.082
    },
    {
      "text": "Профессор расшифровал слово «Абырвалг».",
      "begin": 366.201,
      "end": 369.984
    },
    {
      "text": "Оно означает «главрыба».",
      "begin": 369.824,
      "end": 373.086
    },
    {
      "text": "Что-то чудовище.",
      "begin": 372.666,
      "end": 376.184
    },
    {
      "text": "2 января.",
      "begin": 375.963,
      "end": 378.227
    },
    {
      "text": "Фотографирован во время улыбки при магнии.",
      "begin": 377.365,
      "end": 381.532
    },
    {
      "text": "Встал с постели и уверенно держался полчаса на задних лапах.",
      "begin": 381.251,
      "end": 386.599
    },
    {
      "text": "Моего почти роста.",
      "begin": 386.199,
      "end": 388.923
    },
    {
      "text": "В тетради вкладной лист.",
      "begin": 388.883,
      "end": 391.764
    },
    {
      "text": "Русская наука чуть не понесла тяжелую утрату.",
      "begin": 391.364,
      "end": 395.207
    },
    {
      "text": "История болезни профессора Филиппа Филипповича Преображенского.",
      "begin": 394.787,
      "end": 400.011
    },
    {
      "text": "В 1 час 13 минут глубокий обморок с профессором Преображенским.",
      "begin": 399.971,
      "end": 406.836
    },
    {
      "text": "При падении ударился головой о ножку стула.",
      "begin": 406.696,
      "end": 410.879
    },
    {
      "text": "Тинктура Валериана.",
      "begin": 410.279,
      "end": 412.701
    },
    {
      "text": "В моем изины присутствии пёс, если псом, конечно, можно назвать, обругал профессора Преображенского по матери.",
      "begin": 412.661,
      "end": 422.522
    },
    {
      "text": "Перерыв в записях.",
      "begin": 421.862,
      "end": 425.243
    },
    {
      "text": "6 января.",
      "begin": 424.943,
      "end": 426.784
    },
    {
      "text": "То карандашом, то фиолетовыми чернилами.",
      "begin": 426.644,
      "end": 431.346
    },
    {
      "text": "Сегодня, после того, как у него отвалился хвост, он произнес совершенно отчетливо слово «пивная».",
      "begin": 430.866,
      "end": 439.89
    },
    {
      "text": "Работает фонограф.",
      "begin": 439.35,
      "end": 441.711
    },
    {
      "text": "Черт знает, что такое.",
      "begin": 441.43,
      "end": 444.218
    },
    {
      "text": "Я теряюсь.",
      "begin": 444.118,
      "end": 446.621
    },
    {
      "text": "Прием у профессора прекращен.",
      "begin": 446.241,
      "end": 449.284
    },
    {
      "text": "Начиная с пяти часов дня, из смотровой, где расхаживает это существо, слышится явственно вульгарная ругань и слова «еще парочку».",
      "begin": 448.884,
      "end": 460.513
    },
    {
      "text": "7 января.",
      "begin": 460.173,
      "end": 461.974
    },
    {
      "text": "Он произносит очень много слов.",
      "begin": 461.834,
      "end": 465.556
    },
    {
      "text": "Извозчик, мест нету, вечерняя газета, лучший подарок детям и все бранные слова, какие только существуют в русском лексиконе.",
      "begin": 464.375,
      "end": 475.481
    },
    {
      "text": "Вид его странен.",
      "begin": 475.281,
      "end": 477.822
    },
    {
      "text": "Шерсть осталась только на голове, на подбородке и на груди.",
      "begin": 477.142,
      "end": 482.624
    },
    {
      "text": "В остальном он лыс, с дряблой кожей.",
      "begin": 482.584,
      "end": 486.688
    },
    {
      "text": "В области половых органов формирующийся мужчина.",
      "begin": 486.648,
      "end": 491.473
    },
    {
      "text": "Череп увеличился значительно, лоб скошен и низок.",
      "begin": 491.133,
      "end": 497.86
    },
    {
      "text": "Ей-богу, я с ума сойду.",
      "begin": 497.339,
      "end": 500.963
    },
    {
      "text": "Филипп Филиппович все еще чувствует себя плохо.",
      "begin": 500.683,
      "end": 505.148
    },
    {
      "text": "Большинство наблюдений веду я.",
      "begin": 504.607,
      "end": 508.211
    },
    {
      "text": "Фонограф, фотографии.",
      "begin": 507.19,
      "end": 510.488
    },
    {
      "text": "По городу расплылись слухи.",
      "begin": 510.388,
      "end": 514.51
    },
    {
      "text": "Последствия неисчислимые.",
      "begin": 513.71,
      "end": 516.391
    },
    {
      "text": "Сегодня днем весь переулок был полон какими-то бездельниками и старухами.",
      "begin": 515.971,
      "end": 522.754
    },
    {
      "text": "Зеваки стоят и сейчас еще под окнами.",
      "begin": 522.354,
      "end": 525.456
    },
    {
      "text": "В утренних газетах появилась удивительная заметка.",
      "begin": 525.416,
      "end": 529.958
    },
    {
      "text": "Слухи о марсианине в Обуховском переулке ни на чем не основаны, они распущены торговцами с Сухаревки и будут строго наказаны.",
      "begin": 529.538,
      "end": 540.671
    },
    {
      "text": "О каком к черту марсианине?",
      "begin": 540.631,
      "end": 543.894
    },
    {
      "text": "Ведь это кошмар.",
      "begin": 543.674,
      "end": 546.356
    },
    {
      "text": "Еще лучше в вечерней.",
      "begin": 546.096,
      "end": 548.919
    },
    {
      "text": "Написали, что родился ребенок, который играет на скрипке.",
      "begin": 548.418,
      "end": 553.022
    },
    {
      "text": "Тут же рисунок, скрипка и моя фотографическая карточка.",
      "begin": 552.822,
      "end": 557.607
    },
    {
      "text": "И под ней подпись.",
      "begin": 557.567,
      "end": 559.889
    },
    {
      "text": "Профессор Преображенский, делавший кесарево сечение у матери.",
      "begin": 559.348,
      "end": 565.434
    },
    {
      "text": "Это что-то неописуемое.",
      "begin": 565.274,
      "end": 568.199
    },
    {
      "text": "Он говорит новое слово «милиционер».",
      "begin": 568.039,
      "end": 573.603
    },
    {
      "text": "Оказывается, Дарья Петровна была в меня влюблена и свистнула карточку из альбома Филиппа Филипповича.",
      "begin": 572.902,
      "end": 580.427
    },
    {
      "text": "После того, как прогнал репортеров, один из них пролез на кухню и так далее.",
      "begin": 580.107,
      "end": 586.951
    },
    {
      "text": "Что творится во время приема?",
      "begin": 586.791,
      "end": 589.413
    },
    {
      "text": "Сегодня было 82 звонка.",
      "begin": 589.032,
      "end": 592.134
    },
    {
      "text": "Телефон выключен.",
      "begin": 591.614,
      "end": 593.995
    },
    {
      "text": "Бездетные дамы с ума сошли и идут.",
      "begin": 593.395,
      "end": 597.865
    },
    {
      "text": "В полном составе домком во главе со Швондером.",
      "begin": 597.845,
      "end": 602.685
    },
    {
      "text": "Зачем?",
      "begin": 601.801,
      "end": 603.006
    },
    {
      "text": "Сами не знают.",
      "begin": 602.745,
      "end": 605.84
    },
    {
      "text": "8 января поздним вечером поставили диагноз.",
      "begin": 605.38,
      "end": 610.141
    },
    {
      "text": "Филипп Филиппович, как истый ученый, признал свою ошибку.",
      "begin": 609.881,
      "end": 615.622
    },
    {
      "text": "Перемена гипофиза дает не омоложение, а полное очеловечение, подчеркнуто три раза.",
      "begin": 615.162,
      "end": 624.304
    },
    {
      "text": "От этого его изумительное, потрясающее открытие не становится ничуть меньше.",
      "begin": 624.164,
      "end": 631.365
    },
    {
      "text": "Тот сегодня впервые прошелся по квартире.",
      "begin": 631.165,
      "end": 635.087
    },
    {
      "text": "Смеялся в коридоре, глядя на электрическую лампу.",
      "begin": 634.547,
      "end": 639.149
    },
    {
      "text": "Затем, в сопровождении Филиппа Филипповича и меня, он проследовал в кабинет.",
      "begin": 638.329,
      "end": 645.132
    },
    {
      "text": "Он стойко держится на задних лапах, зачеркнуто, на ногах, и производит впечатление маленького и плохо сложенного мужчины.",
      "begin": 644.992,
      "end": 656.425
    },
    {
      "text": "Смеялся в кабинете.",
      "begin": 655.924,
      "end": 658.446
    },
    {
      "text": "Улыбка его неприятна и как бы искусственна.",
      "begin": 658.026,
      "end": 662.27
    },
    {
      "text": "Затем он почесал затылок, огляделся, и я записал новое, отчетливо произнесенное слово «буржуи».",
      "begin": 661.97,
      "end": 672.479
    },
    {
      "text": "Ругался.",
      "begin": 671.078,
      "end": 672.919
    },
    {
      "text": "Ругань эта методическая, беспрерывная и, по-видимому, совершенно бессмысленная.",
      "begin": 672.559,
      "end": 679.365
    },
    {
      "text": "Она носит несколько фонографический характер.",
      "begin": 679.185,
      "end": 682.628
    },
    {
      "text": "Как будто это существо где-то раньше слышало бранные слова, автоматически, подсознательно занесло их в свой мозг и теперь изрыгает их пачками.",
      "begin": 682.488,
      "end": 693.81
    },
    {
      "text": "А впрочем, я не психиатр, черт меня возьми.",
      "begin": 693.77,
      "end": 697.891
    },
    {
      "text": "На Филиппа Филипповича брань производит почему-то удивительно тягостное впечатление.",
      "begin": 697.811,
      "end": 703.592
    },
    {
      "text": "Бывают моменты, когда он выходит из сдержанного и холодного наблюдения новых явлений и как бы теряет терпение.",
      "begin": 703.212,
      "end": 712.262
    },
    {
      "text": "Так, в момент ругани, он вдруг нервно выкрикнул «Перестань!».",
      "begin": 711.822,
      "end": 718.405
    },
    {
      "text": "Это не произвело никакого эффекта.",
      "begin": 718.225,
      "end": 722.346
    },
    {
      "text": "После прогулки в кабинете, общими усилиями Шарик был водворен в смотровую.",
      "begin": 722.046,
      "end": 728.669
    },
    {
      "text": "После этого мы имели совещание с Филиппом Филипповичем.",
      "begin": 728.369,
      "end": 733.211
    },
    {
      "text": "Впервые, я должен сознаться, я видел этого уверенного и поразительно умного человека растерянным.",
      "begin": 732.371,
      "end": 742.078
    },
    {
      "text": "Напевая по своему обыкновению, он спросил, «Что же мы теперь будем делать?»",
      "begin": 741.598,
      "end": 748.081
    },
    {
      "text": "И сам же ответил буквально так, «Москва-Швея, да, от Севильи до Гренады.",
      "begin": 748.041,
      "end": 756.404
    },
    {
      "text": "Москва-Швея, дорогой доктор».",
      "begin": 755.604,
      "end": 758.705
    },
    {
      "text": "Я ничего не понял.",
      "begin": 758.625,
      "end": 760.526
    },
    {
      "text": "Он пояснил, «Я вас прошу, Иван Арнольдович, купить ему белье, штаны и пиджак».",
      "begin": 760.386,
      "end": 769.39
    },
    {
      "text": "9 января.",
      "begin": 769.249,
      "end": 771.744
    },
    {
      "text": "Лексикон обогащается каждые пять минут в среднем новым словом, с сегодняшнего утра и фразами.",
      "begin": 771.203,
      "end": 779.795
    },
    {
      "text": "Похоже, что они, замерзшие в сознании, оттаивают и выходят.",
      "begin": 779.274,
      "end": 786.484
    },
    {
      "text": "Вышедшее слово остается в употреблении.",
      "begin": 785.943,
      "end": 789.226
    },
    {
      "text": "Со вчерашнего вечера фонографом отмечены «Не толкайся, подлец!",
      "begin": 789.166,
      "end": 795.655
    },
    {
      "text": "Слезай с подножки!",
      "begin": 795.274,
      "end": 797.377
    },
    {
      "text": "Я тебе покажу признание Америки и примус!»",
      "begin": 797.257,
      "end": 802.885
    },
    {
      "text": "10 января.",
      "begin": 802.725,
      "end": 805.328
    },
    {
      "text": "Произошло одевание.",
      "begin": 804.387,
      "end": 807.42
    },
    {
      "text": "Нижнюю сорочку позволил надеть на себя охотно, даже весело смеясь.",
      "begin": 807.04,
      "end": 812.783
    },
    {
      "text": "От кальсон отказался, выразив протест хриплыми криками.",
      "begin": 812.683,
      "end": 817.745
    },
    {
      "text": "«В очередь, сукины дети, в очередь!»",
      "begin": 817.665,
      "end": 821.727
    },
    {
      "text": "Был одет.",
      "begin": 821.287,
      "end": 823.408
    },
    {
      "text": "Носки ему велики.",
      "begin": 823.028,
      "end": 825.569
    },
    {
      "text": "В тетради какие-то схематические рисунки, по всем признакам изображающие превращение собачьей ноги в человеческую.",
      "begin": 825.529,
      "end": 836.084
    },
    {
      "text": "Удлиняется задняя половина скелета стопы, планта, вытягивание пальцев, когти.",
      "begin": 835.423,
      "end": 843.889
    },
    {
      "text": "Повторное систематическое обучение посещения уборной.",
      "begin": 843.289,
      "end": 848.352
    },
    {
      "text": "Прислуга совершенно подавлена.",
      "begin": 847.812,
      "end": 850.874
    },
    {
      "text": "Но следует отметить понятливость существа.",
      "begin": 850.774,
      "end": 854.777
    },
    {
      "text": "Дело вполне идет на лад.",
      "begin": 854.477,
      "end": 858.645
    },
    {
      "text": "11 января.",
      "begin": 857.985,
      "end": 861.367
    },
    {
      "text": "Совершенно примирился со штанами.",
      "begin": 860.427,
      "end": 864.869
    },
    {
      "text": "Произнес длинную веселую фразу.",
      "begin": 863.969,
      "end": 867.471
    },
    {
      "text": "«Дай папиросочку, у тебя брюки в полосочку».",
      "begin": 867.271,
      "end": 871.953
    },
    {
      "text": "Шерсть на голове слабая, шелковистая.",
      "begin": 871.573,
      "end": 875.534
    },
    {
      "text": "Легко спутать с волосами.",
      "begin": 875.234,
      "end": 877.295
    },
    {
      "text": "Но подпалины остались на темени.",
      "begin": 877.215,
      "end": 880.776
    },
    {
      "text": "Сегодня облез последний пух с ушей.",
      "begin": 880.316,
      "end": 884.458
    },
    {
      "text": "Колоссальный аппетит.",
      "begin": 883.717,
      "end": 885.798
    },
    {
      "text": "С увлечением ест селедку.",
      "begin": 885.758,
      "end": 889.26
    },
    {
      "text": "В пять часов дня события, впервые слова, произнесенные существом, не были оторваны от окружающих явлений, а явились реакцией на них.",
      "begin": 889.22,
      "end": 901.872
    },
    {
      "text": "Именно, когда профессор приказал ему «не бросай объедки на пол», неожиданно ответил «отлезь, гнида».",
      "begin": 900.971,
      "end": 910.774
    },
    {
      "text": "Филипп Филиппович был поражен, потом оправился и сказал, если ты еще раз позволишь себе обругать меня или доктора, тебе влетит.",
      "begin": 910.514,
      "end": 921.459
    },
    {
      "text": "Я фотографировал в это мгновение Шарика.",
      "begin": 921.319,
      "end": 925.561
    },
    {
      "text": "Ручаюсь, что он понял слова профессора.",
      "begin": 924.681,
      "end": 928.943
    },
    {
      "text": "Угрюмая тень легла на его лицо.",
      "begin": 928.443,
      "end": 931.804
    },
    {
      "text": "Поглядел из-под лобья довольно раздраженно, но стих.",
      "begin": 931.304,
      "end": 936.427
    },
    {
      "text": "Ура, он понимает.",
      "begin": 935.666,
      "end": 939.643
    },
    {
      "text": "12 января.",
      "begin": 939.203,
      "end": 941.624
    },
    {
      "text": "Закладывание рук в карманы штанов.",
      "begin": 940.863,
      "end": 944.444
    },
    {
      "text": "Отучаем от Ругани.",
      "begin": 943.884,
      "end": 946.645
    },
    {
      "text": "Свистал, ой, яблочко.",
      "begin": 945.845,
      "end": 948.985
    },
    {
      "text": "Поддерживает разговор.",
      "begin": 948.225,
      "end": 950.786
    },
    {
      "text": "Я не могу удержаться от нескольких гипотез.",
      "begin": 950.686,
      "end": 954.027
    },
    {
      "text": "К чертям омоложение пока что.",
      "begin": 954.007,
      "end": 957.968
    },
    {
      "text": "Другое, неизмеримо более важно.",
      "begin": 956.967,
      "end": 961.549
    },
    {
      "text": "Изумительный опыт профессора Преображенского раскрыл одну из тайн человеческого мозга.",
      "begin": 960.648,
      "end": 968.907
    },
    {
      "text": "Отныне загадочная функция гипофиза –",
      "begin": 968.446,
      "end": 972.072
    },
    {
      "text": "мозгового придатка –",
      "begin": 971.511,
      "end": 974.876
    },
    {
      "text": "разъяснена.",
      "begin": 973.174,
      "end": 975.036
    },
    {
      "text": "Он определяет человеческий облик.",
      "begin": 974.896,
      "end": 978.462
    },
    {
      "text": "Его гормоны можно назвать важнейшими в организме –",
      "begin": 978.282,
      "end": 982.869
    },
    {
      "text": "гормонами облика.",
      "begin": 981.827,
      "end": 985.457
    },
    {
      "text": "Новая область открывается в науке.",
      "begin": 984.916,
      "end": 988.059
    },
    {
      "text": "Безо всякой реторты Фауста создан гомункул.",
      "begin": 987.819,
      "end": 993.323
    },
    {
      "text": "Скальпель, хирурга, вызвал к жизни новую человеческую единицу.",
      "begin": 992.603,
      "end": 998.468
    },
    {
      "text": "Профессор Преображенский, вы творец.",
      "begin": 997.947,
      "end": 1004.973
    },
    {
      "text": "Хлякса.",
      "begin": 1002.531,
      "end": 1005.453
    },
    {
      "text": "Впрочем, я уклонился в сторону.",
      "begin": 1004.993,
      "end": 1007.976
    },
    {
      "text": "Итак, он поддерживает разговор.",
      "begin": 1007.235,
      "end": 1010.398
    },
    {
      "text": "По моему предположению, дело обстоит так.",
      "begin": 1010.318,
      "end": 1014.348
    },
    {
      "text": "Прижившийся гипофиз открыл центр речи собачьим мозгу, и слова хлынули потоком.",
      "begin": 1013.668,
      "end": 1021.791
    },
    {
      "text": "По-моему, перед нами оживший развернувшийся мозг, а не мозг, вновь созданный.",
      "begin": 1021.291,
      "end": 1027.773
    },
    {
      "text": "О, дивное подтверждение эволюционной теории!",
      "begin": 1027.613,
      "end": 1033.054
    },
    {
      "text": "О, цепь величайшая от Пса до Менделеева-химика!",
      "begin": 1032.274,
      "end": 1039.35
    },
    {
      "text": "Еще моя гипотеза.",
      "begin": 1039.03,
      "end": 1041.512
    },
    {
      "text": "Мозг Шарика в собачьем периоде его жизни накопил бездну понятий.",
      "begin": 1041.211,
      "end": 1047.415
    },
    {
      "text": "Все слова, которыми он начал оперировать в первую очередь, уличные слова, он их слышал и затаил в мозгу.",
      "begin": 1047.195,
      "end": 1058.141
    },
    {
      "text": "Теперь, проходя по улице, я с тайным ужасом смотрю на встречных псов.",
      "begin": 1057.341,
      "end": 1064.185
    },
    {
      "text": "Бог их знает, что у них таится в мозгах.",
      "begin": 1063.925,
      "end": 1070.551
    },
    {
      "text": "Шарик читал.",
      "begin": 1070.11,
      "end": 1073.573
    },
    {
      "text": "Читал.",
      "begin": 1070.631,
      "end": 1073.573
    },
    {
      "text": "Три восклицательных знака.",
      "begin": 1073.613,
      "end": 1076.236
    },
    {
      "text": "Это я догадался.",
      "begin": 1076.036,
      "end": 1078.158
    },
    {
      "text": "Погла в рыбе.",
      "begin": 1077.757,
      "end": 1079.999
    },
    {
      "text": "Именно с конца читал.",
      "begin": 1079.599,
      "end": 1082.301
    },
    {
      "text": "И я даже знаю, где разрешение этой загадки.",
      "begin": 1082.261,
      "end": 1085.965
    },
    {
      "text": "В перерыве зрительных нервов у собаки.",
      "begin": 1085.945,
      "end": 1090.324
    },
    {
      "text": "Что в Москве творится, уму непостижимо человеческому.",
      "begin": 1090.064,
      "end": 1095.448
    },
    {
      "text": "Семь сухаревских торговцев уже сидят за распространение слухов о свето-представлении, которое навлекли большевики.",
      "begin": 1095.208,
      "end": 1105.115
    },
    {
      "text": "Дарья Петровна говорила и даже точно называла число 28 ноября 1925 года.",
      "begin": 1104.815,
      "end": 1114.221
    },
    {
      "text": "В день преподобного мученика Стефана земля налетит на небесную ось.",
      "begin": 1114.181,
      "end": 1121.569
    },
    {
      "text": "Какие-то жулики уже читают лекции.",
      "begin": 1121.128,
      "end": 1124.618
    },
    {
      "text": "Такой кабак мы сделали с этим гипофизом, что хоть вон беги из квартиры.",
      "begin": 1124.237,
      "end": 1131.618
    },
    {
      "text": "Я переехал к Преображенскому по его просьбе и ночую в приемной с шариком.",
      "begin": 1131.518,
      "end": 1138.34
    },
    {
      "text": "Смотровая превращена в приемную.",
      "begin": 1137.7,
      "end": 1141.52
    },
    {
      "text": "Швондер оказался прав.",
      "begin": 1141.04,
      "end": 1143.981
    },
    {
      "text": "Домком злорадствует.",
      "begin": 1143.181,
      "end": 1146.042
    },
    {
      "text": "В шкафах ни одного стекла, потому что прыгал.",
      "begin": 1146.002,
      "end": 1151.043
    },
    {
      "text": "Еле отучили.",
      "begin": 1150.783,
      "end": 1153.29
    },
    {
      "text": "С Филиппом Филипповичем что-то странное делается.",
      "begin": 1153.25,
      "end": 1157.413
    },
    {
      "text": "Когда я ему рассказал о своих гипотезах и о надежде развить Шарика в очень высокую психическую личность, он хмыкнул и ответил «Вы думаете?»",
      "begin": 1157.092,
      "end": 1170.375
    },
    {
      "text": "то он его зловещий.",
      "begin": 1170.315,
      "end": 1173.078
    },
    {
      "text": "Неужели я ошибся?",
      "begin": 1172.598,
      "end": 1175.341
    },
    {
      "text": "Старик что-то придумал.",
      "begin": 1174.94,
      "end": 1177.583
    },
    {
      "text": "Пока я вожусь с историей болезни, он сидит над историей того человека, от которого мы взяли гипофиз.",
      "begin": 1177.303,
      "end": 1186.755
    },
    {
      "text": "В тетради вкладной лист.",
      "begin": 1186.715,
      "end": 1189.356
    },
    {
      "text": "Клим Григорьевич Чугункин, 25 лет, холост.",
      "begin": 1189.036,
      "end": 1195.737
    },
    {
      "text": "Беспартийный, сочувствующий.",
      "begin": 1194.397,
      "end": 1198.038
    },
    {
      "text": "Судился три раза и оправдан.",
      "begin": 1197.538,
      "end": 1200.659
    },
    {
      "text": "В первый раз благодаря недостатку улик.",
      "begin": 1200.619,
      "end": 1203.98
    },
    {
      "text": "Второй раз происхождение спасло.",
      "begin": 1203.6,
      "end": 1206.72
    },
    {
      "text": "В третий раз условно каторга на 15 лет.",
      "begin": 1206.68,
      "end": 1212.142
    },
    {
      "text": "Кражи.",
      "begin": 1210.762,
      "end": 1213.322
    },
    {
      "text": "Профессия –",
      "begin": 1212.162,
      "end": 1213.722
    },
    {
      "text": "игра на балалайке по трактирам.",
      "begin": 1213.402,
      "end": 1217.224
    },
    {
      "text": "Маленького роста, плохо сложен.",
      "begin": 1216.663,
      "end": 1219.947
    },
    {
      "text": "Печень расширена, алкоголь.",
      "begin": 1219.546,
      "end": 1222.91
    },
    {
      "text": "Причина смерти –",
      "begin": 1222.489,
      "end": 1224.091
    },
    {
      "text": "удар ножом в сердце, в пивной.",
      "begin": 1223.81,
      "end": 1227.814
    },
    {
      "text": "Стоп-сигнал у преображенской заставы.",
      "begin": 1226.733,
      "end": 1231.058
    },
    {
      "text": "Старик, не отрываясь, сидит над климовской болезнью.",
      "begin": 1230.637,
      "end": 1234.801
    },
    {
      "text": "Не понимаю, в чем дело.",
      "begin": 1234.721,
      "end": 1237.204
    },
    {
      "text": "Бурчал что-то насчет того…",
      "begin": 1236.763,
      "end": 1239.046
    },
    {
      "text": "что вот не догадался осмотреть в патологоанатомическом весь труп Чугункина.",
      "begin": 1238.885,
      "end": 1245.994
    },
    {
      "text": "В чем дело, не понимаю.",
      "begin": 1245.974,
      "end": 1248.557
    },
    {
      "text": "Не все ли равно, чей гипофиз?",
      "begin": 1248.477,
      "end": 1252.82
    },
    {
      "text": "17 января.",
      "begin": 1252.319,
      "end": 1254.622
    },
    {
      "text": "Не записывал несколько дней, болел инфлюенцией.",
      "begin": 1254.522,
      "end": 1258.846
    },
    {
      "text": "За это время облик окончательно сложился.",
      "begin": 1258.766,
      "end": 1263.491
    },
    {
      "text": "Совершенный человек по строению тела.",
      "begin": 1263.511,
      "end": 1268.397
    },
    {
      "text": "Вес около 3 пудов.",
      "begin": 1268.457,
      "end": 1272.001
    },
    {
      "text": "Рост маленький.",
      "begin": 1272.061,
      "end": 1274.783
    },
    {
      "text": "Голова маленькая.",
      "begin": 1274.843,
      "end": 1277.204
    },
    {
      "text": "Начал курить.",
      "begin": 1277.264,
      "end": 1279.644
    },
    {
      "text": "Ест человеческую пищу.",
      "begin": 1279.764,
      "end": 1282.805
    },
    {
      "text": "Одевается самостоятельно.",
      "begin": 1282.845,
      "end": 1285.945
    },
    {
      "text": "Гладко ведет разговор.",
      "begin": 1285.985,
      "end": 1289.046
    },
    {
      "text": "Вот так гипофиз.",
      "begin": 1288.846,
      "end": 1292.887
    },
    {
      "text": "Клякса.",
      "begin": 1290.886,
      "end": 1293.227
    },
    {
      "text": "Этим историю болезни заканчиваю.",
      "begin": 1292.947,
      "end": 1295.947
    },
    {
      "text": "Перед нами новый организм.",
      "begin": 1295.687,
      "end": 1298.548
    },
    {
      "text": "Наблюдать его нужно сначала.",
      "begin": 1298.048,
      "end": 1302.52
    },
    {
      "text": "Приложение.",
      "begin": 1300.998,
      "end": 1303.3
    },
    {
      "text": "Стенограммы речи, записи фонографа, фотографические снимки.",
      "begin": 1302.56,
      "end": 1309.967
    },
    {
      "text": "Подпись.",
      "begin": 1308.926,
      "end": 1310.628
    },
    {
      "text": "Ассистент профессора Филиппа Филипповича Преображенского, доктор Барменталь.",
      "begin": 1310.027,
      "end": 1315.893
    }
  ]
}