{
  "audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/bible-nrp/13-01.mp3",
  "narrator": "audiobook",
  "fragments": [
    {
      "text": "От Адама до Ноя.",
      "begin": 0.428,
      "end": 3.634
    },
    {
      "text": "Адам, Сиф, Енос, Каинан, Малилиил и Орет, Енох, Мафуса, Ламех.",
      "begin": 3.013,
      "end": 9.932
    },
    {
      "text": "Ной и его сыновья —",
      "begin": 9.652,
      "end": 11.513
    },
    {
      "text": "Сим, Хам и Афет.",
      "begin": 11.153,
      "end": 13.474
    },
    {
      "text": "Потомки Иофета.",
      "begin": 13.034,
      "end": 15.215
    },
    {
      "text": "Сыновья Иофеты —",
      "begin": 14.715,
      "end": 16.415
    },
    {
      "text": "Гомер, Магок, Мадай, Иован, Тувал, Мешех и Терас.",
      "begin": 15.875,
      "end": 21.278
    },
    {
      "text": "Сыновья Гомера —",
      "begin": 20.858,
      "end": 22.378
    },
    {
      "text": "Ашкина, Сарифат и Тагарма.",
      "begin": 21.838,
      "end": 25.12
    },
    {
      "text": "Сыновья Иована —",
      "begin": 24.56,
      "end": 26.641
    },
    {
      "text": "Элиша, Таршиш, Китим и Раданим.",
      "begin": 26.14,
      "end": 29.502
    },
    {
      "text": "Потомки Хама.",
      "begin": 29.082,
      "end": 31.063
    },
    {
      "text": "Сыновья Хама —",
      "begin": 30.603,
      "end": 32.043
    },
    {
      "text": "Куш, Мицераим, Пут и Ханаан.",
      "begin": 31.743,
      "end": 34.825
    },
    {
      "text": "Сыновья Куша —",
      "begin": 34.364,
      "end": 35.945
    },
    {
      "text": "Сева, Хавила, Савта, Рама и Савтеха.",
      "begin": 35.565,
      "end": 39.927
    },
    {
      "text": "Сыновья Раамы, Шева и Дидан.",
      "begin": 39.527,
      "end": 41.968
    },
    {
      "text": "Куш был отцом Инемрода, который стал первым на земле могучим воином.",
      "begin": 41.688,
      "end": 46.931
    },
    {
      "text": "Митцераим был отцом Лудеев, Анамеев, Лигавеев, Навтухеев, Патрусеев, Кослухеев, от которых произошли филистимляне, и Кавтареев.",
      "begin": 46.351,
      "end": 57.177
    },
    {
      "text": "Ханаан был отцом Сидона, первенца его Хетта, а также Иоусеев, Амареев, Гергисеев, Хевеев, Аркеев, Синеев, Арвадеев, Цимореев и Хаматеев.",
      "begin": 56.756,
      "end": 68.312
    },
    {
      "text": "Потомки Сима.",
      "begin": 67.892,
      "end": 70.113
    },
    {
      "text": "Сыновья Сима —",
      "begin": 69.653,
      "end": 71.654
    },
    {
      "text": "Елам, Ашур, Арпахшад, Луд и Арам.",
      "begin": 71.114,
      "end": 74.876
    },
    {
      "text": "Сыновья Арама —",
      "begin": 74.476,
      "end": 75.897
    },
    {
      "text": "Уц, Хул, Гетер и Мешех.",
      "begin": 75.437,
      "end": 77.918
    },
    {
      "text": "У Арпахшада родился Шелах, а у Шелаха родился Евер.",
      "begin": 77.878,
      "end": 81.84
    },
    {
      "text": "У Евера родилось двое сыновей, одного звали Пелек, потому что в его дни земля была разделена, а его брата —",
      "begin": 81.78,
      "end": 89.485
    },
    {
      "text": "Иоктан.",
      "begin": 88.685,
      "end": 90.105
    },
    {
      "text": "Иоктан был отцом Алмадада, Шалефа, Хацармавета, Иераха, Гадарама, Узала, Диклы, Евала, Авимаила, Шевы, Афира, Хавилы и Авава.",
      "begin": 89.605,
      "end": 104.729
    },
    {
      "text": "Все они были сыновьями Иоктана.",
      "begin": 104.429,
      "end": 107.55
    },
    {
      "text": "Сим, Арпахшат, Шулах, Евер, Пеле, Креу, Сирук, Нагор, Тирах, Авраам.",
      "begin": 107.15,
      "end": 113.751
    },
    {
      "text": "Позже он был назван Авраамом.",
      "begin": 113.411,
      "end": 116.975
    },
    {
      "text": "Сыновья Авраама.",
      "begin": 116.535,
      "end": 118.416
    },
    {
      "text": "Сыновья Авраама, Исаак и Измаил.",
      "begin": 118.016,
      "end": 121.357
    },
    {
      "text": "Потомки Авраама от Агари.",
      "begin": 120.817,
      "end": 123.318
    },
    {
      "text": "Вот их родословия.",
      "begin": 123.098,
      "end": 125.619
    },
    {
      "text": "Невайот, первенец Измаила.",
      "begin": 124.978,
      "end": 127.86
    },
    {
      "text": "Кидар от Беэл, Мифсам, Мишма, Дума, Маса, Хада, Тема и Итур.",
      "begin": 127.319,
      "end": 133.542
    },
    {
      "text": "Нафиш и Кедма.",
      "begin": 133.042,
      "end": 134.422
    },
    {
      "text": "Это сыновья Измаила.",
      "begin": 134.282,
      "end": 136.523
    },
    {
      "text": "Потомки Авраама от Хитуры.",
      "begin": 136.083,
      "end": 138.784
    },
    {
      "text": "Сыновья, которых родила Хитура, наложницы Авраама.",
      "begin": 138.364,
      "end": 142.545
    },
    {
      "text": "Зимран и Акшан, Мидан, Мадиан, Ишбак и Шуах.",
      "begin": 141.925,
      "end": 146.908
    },
    {
      "text": "Сыновья Иакшана, Шева и Ридан.",
      "begin": 146.427,
      "end": 149.973
    },
    {
      "text": "Сыновья Мадиана, Ефа, Ефер, Енох, Авида и Елдага.",
      "begin": 149.332,
      "end": 154.521
    },
    {
      "text": "Все они потомки Хитуры.",
      "begin": 154.26,
      "end": 157.496
    },
    {
      "text": "Потомки Авраама —",
      "begin": 157.056,
      "end": 159.298
    },
    {
      "text": "цары.",
      "begin": 158.297,
      "end": 159.738
    },
    {
      "text": "Авраам был отцом Исаака, сыновья Исаака —",
      "begin": 159.338,
      "end": 163.021
    },
    {
      "text": "Исаф и Израиль.",
      "begin": 162.6,
      "end": 164.622
    },
    {
      "text": "Потомки Исаава.",
      "begin": 164.202,
      "end": 166.363
    },
    {
      "text": "Сыновья Исаава —",
      "begin": 165.923,
      "end": 167.825
    },
    {
      "text": "Элифаз, Рагуил и Иуш, Ялам и Карах.",
      "begin": 167.184,
      "end": 172.048
    },
    {
      "text": "Сыновья Элифаза —",
      "begin": 171.588,
      "end": 173.349
    },
    {
      "text": "Тиман, Амар, Цефа, Гатам, Кенас, Аттимны, Амалик.",
      "begin": 172.769,
      "end": 178.873
    },
    {
      "text": "Сыновья Рагуила —",
      "begin": 178.453,
      "end": 180.615
    },
    {
      "text": "Нахат, Зирах, Шамма и Миза.",
      "begin": 179.754,
      "end": 184.129
    },
    {
      "text": "Исконные жители дома.",
      "begin": 183.508,
      "end": 186.051
    },
    {
      "text": "Сыновья Сиира —",
      "begin": 185.591,
      "end": 187.353
    },
    {
      "text": "Латан, Шавал, Цевион, Анна, Дишон, Ецер, Дишан.",
      "begin": 186.792,
      "end": 191.938
    },
    {
      "text": "Сыновья Латана —",
      "begin": 191.478,
      "end": 193.059
    },
    {
      "text": "Хори и Гамам.",
      "begin": 192.719,
      "end": 194.581
    },
    {
      "text": "Сестрой Латана была Тимна.",
      "begin": 194.181,
      "end": 196.804
    },
    {
      "text": "Сыновья Шавала —",
      "begin": 196.403,
      "end": 198.025
    },
    {
      "text": "Алиан, Монахат, Евел, Шефа и Анам.",
      "begin": 197.465,
      "end": 201.59
    },
    {
      "text": "Сыновья Цевиона, Ая и Анна.",
      "begin": 201.189,
      "end": 204.154
    },
    {
      "text": "Сын Анны Дишон.",
      "begin": 203.873,
      "end": 205.796
    },
    {
      "text": "Сыновья Дишона, Химдан, Эшбан, Ифран и Хиран.",
      "begin": 205.435,
      "end": 209.782
    },
    {
      "text": "Сыновья Ицера, Билган, Зааван и Яакан.",
      "begin": 209.401,
      "end": 213.307
    },
    {
      "text": "Сыновья Дишана, Уц и Аран.",
      "begin": 212.906,
      "end": 215.751
    },
    {
      "text": "Правители дома.",
      "begin": 215.27,
      "end": 217.62
    },
    {
      "text": "Вот цари, которые правили в Идоме еще до того, как в Израиле появились цари.",
      "begin": 217.42,
      "end": 222.762
    },
    {
      "text": "Бела, сын Беора, чей город назывался Дингава.",
      "begin": 222.242,
      "end": 226.183
    },
    {
      "text": "После смерти Белы царем вместо него стал Иавав, сын Зераха из Боцры.",
      "begin": 225.883,
      "end": 231.965
    },
    {
      "text": "После смерти Иавава царем вместо него стал Хушам из земли Тиманитян.",
      "begin": 231.665,
      "end": 237.467
    },
    {
      "text": "После смерти Хушама царем вместо него стал Гадад, сын Бедада, который разбил Мадианитян в земле Маава.",
      "begin": 237.127,
      "end": 245.169
    },
    {
      "text": "Его город назывался Авид.",
      "begin": 245.009,
      "end": 247.69
    },
    {
      "text": "После смерти Гадада царем вместо него стал Самла из Масреки.",
      "begin": 247.33,
      "end": 252.413
    },
    {
      "text": "После смерти Самлы царем вместо него стал Саул из Рихавоты, что у реки.",
      "begin": 252.073,
      "end": 257.917
    },
    {
      "text": "После смерти Саула царем вместо него стал Баалханан, сын Ахбора.",
      "begin": 257.557,
      "end": 262.9
    },
    {
      "text": "После смерти Баалханана царем вместо него стал Гадад.",
      "begin": 262.58,
      "end": 266.542
    },
    {
      "text": "Его город назывался Пау, а имя его жены было Мегитавель.",
      "begin": 266.382,
      "end": 271.746
    },
    {
      "text": "Она была дочерью Матреды, внучкой Мизагава.",
      "begin": 271.486,
      "end": 277.029
    },
    {
      "text": "Потом умер Игадат.",
      "begin": 276.709,
      "end": 278.971
    },
    {
      "text": "Вождями Эдома были Тимна, Алва и Этет, Аголивама, Элла, Пинон, Кенас, Тиман, Мифцар, Магдеил и Ирам.",
      "begin": 278.43,
      "end": 287.957
    },
    {
      "text": "Это вожди Эдома.",
      "begin": 287.857,
      "end": 289.218
    }
  ],
  "noHighlight": true
}