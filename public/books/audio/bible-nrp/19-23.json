{"audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/bible-nrp/19-23.mp3", "narrator": "Новые горизонты", "year": 2006, "fragments": [{"text": "Псалом 23", "begin": 0.0, "end": 2.12}, {"text": "Псалом Давида.", "begin": 2.12, "end": 5.52}, {"text": "1 Господня земля и все, что наполняет ее,", "begin": 5.52, "end": 9.56}, {"text": "мир и все, что живет в нем.", "begin": 9.56, "end": 11.96}, {"text": "2 Ведь Он поставил ее на морях,", "begin": 11.96, "end": 14.04}, {"text": "и утвердил на водах a.", "begin": 14.04, "end": 14.48}, {"text": "3 Кто взойдет на гору Господню?", "begin": 14.48, "end": 18.0}, {"text": "Кто встанет на святом месте Его?", "begin": 18.0, "end": 20.64}, {"text": "4 Тот, чьи руки чисты и чье сердце непорочно,", "begin": 20.64, "end": 25.08}, {"text": "тот, кто душу идолам не отдает", "begin": 25.08, "end": 27.48}, {"text": "и не клянется ложно.", "begin": 27.48, "end": 29.32}, {"text": "5 Он получит от Господа благословение", "begin": 29.32, "end": 31.84}, {"text": "и оправдание от Бога, Спасителя своего.", "begin": 31.84, "end": 35.36}, {"text": "6 Таково поколение, которое ищет Его,", "begin": 35.36, "end": 38.4}, {"text": "ищет лица Твоего, Бог Иакова b. Пауза", "begin": 38.4, "end": 42.44}, {"text": "7 Врата, поднимите свои верхи,", "begin": 42.44, "end": 45.48}, {"text": "поднимитесь, древние двери,", "begin": 45.48, "end": 46.76}, {"text": "чтобы вошел Царь славы!", "begin": 46.76, "end": 47.64}, {"text": "8 Кто Он, Этот Царь славы?", "begin": 47.64, "end": 49.72}, {"text": "Господь — крепкий и сильный,", "begin": 49.72, "end": 51.16}, {"text": "Господь — сильный в битвах.", "begin": 51.16, "end": 52.8}, {"text": "9 Врата, поднимите свои верхи,", "begin": 52.8, "end": 53.84}, {"text": "поднимитесь, древние двери,", "begin": 53.84, "end": 54.64}, {"text": "чтобы вошел Царь славы!", "begin": 54.64, "end": 55.36}, {"text": "10 Кто Он, Этот Царь славы?", "begin": 55.36, "end": 56.6}, {"text": "Господь Сил c,", "begin": 56.6, "end": 56.88}, {"text": "Он — Царь славы!", "begin": 56.88, "end": 59.2}, {"text": "Примечания", "begin": 59.2, "end": 59.72}, {"text": "aПсалтирь 23:2 Или: «реках».", "begin": 59.72, "end": 61.36}, {"text": "bПсалтирь 23:6 Так в некоторых древних переводах; в нормативном еврейском тексте: «лица твоего, Иаков».", "begin": 61.36, "end": 67.04}, {"text": "cПсалтирь 23:10 Евр.: «ЙГВГ цеваот».", "begin": 67.04, "end": 73.28}]}