  "fragments": [
    {
      "text": "От Матфея, глава первая Родословие Иисуса Родословие Иисуса Христа, сына Давида, сына Авраама Авраам был отцом Исаака, Исаак —",
      "begin": 0.603,
      "end": 17.882
    },
    {
      "text": "отцом Иакова, Иаков —",
      "begin": 17.381,
      "end": 20.244
    },
    {
      "text": "отцом Иуды и его братьев.",
      "begin": 19.764,
      "end": 23.466
    },
    {
      "text": "Иуда —",
      "begin": 22.625,
      "end": 24.046
    },
    {
      "text": "отцом Пареца и Зераха, а матерью их была Фамарь.",
      "begin": 23.586,
      "end": 28.769
    },
    {
      "text": "Парец был отцом Хицрона.",
      "begin": 28.209,
      "end": 31.431
    },
    {
      "text": "Хицрон —",
      "begin": 30.751,
      "end": 31.952
    },
    {
      "text": "отцом Рама.",
      "begin": 31.491,
      "end": 33.393
    },
    {
      "text": "Рам был отцом Аминадава.",
      "begin": 33.112,
      "end": 36.295
    },
    {
      "text": "Аминадав —",
      "begin": 35.634,
      "end": 37.115
    },
    {
      "text": "отцом Нахшона.",
      "begin": 36.375,
      "end": 39.177
    },
    {
      "text": "Нахшон —",
      "begin": 38.496,
      "end": 39.717
    },
    {
      "text": "отцом Салмона.",
      "begin": 39.237,
      "end": 41.518
    },
    {
      "text": "Салмон —",
      "begin": 40.938,
      "end": 42.018
    },
    {
      "text": "отцом Буаза.",
      "begin": 41.598,
      "end": 43.56
    },
    {
      "text": "Матерью Буаза была Рааф.",
      "begin": 43.079,
      "end": 46.301
    },
    {
      "text": "Боас был отцом Авида, матерью Авида была Руфь.",
      "begin": 45.801,
      "end": 50.803
    },
    {
      "text": "Авид был отцом Исея, а Исей отцом царя Давида.",
      "begin": 50.463,
      "end": 55.845
    },
    {
      "text": "Давид был отцом Соломона, матерью Соломона была бывшая жена Урии.",
      "begin": 55.445,
      "end": 62.068
    },
    {
      "text": "Соломон был отцом Раваама, Раваам отцом Ави, Ави отцом Ассы, Асса отцом Иосафата.",
      "begin": 61.547,
      "end": 71.076
    },
    {
      "text": "Иосафат отцом Иорама.",
      "begin": 70.435,
      "end": 73.177
    },
    {
      "text": "Иорам отцом Узии.",
      "begin": 72.637,
      "end": 75.399
    },
    {
      "text": "Узия отцом Иотама.",
      "begin": 74.818,
      "end": 77.781
    },
    {
      "text": "Иотам отцом Ахаза.",
      "begin": 77.14,
      "end": 80.042
    },
    {
      "text": "Ахаз отцом Езекии.",
      "begin": 79.462,
      "end": 82.504
    },
    {
      "text": "Езекия отцом Монассии.",
      "begin": 81.944,
      "end": 84.926
    },
    {
      "text": "Монассия отцом Омона.",
      "begin": 84.165,
