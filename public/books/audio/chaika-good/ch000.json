{"audio_url": "https://pub-84adcd23e17e4925a0ac7eca17ea2556.r2.dev/chaika-good/01.mp3", "narrator": "audiobook", "fragments": [{"text": "Антон Павлович Чехов.", "begin": 0.271, "end": 2.892, "words": [{"word": "Антон", "begin": 0.271, "end": 1.011}, {"word": "Павлович", "begin": 1.071, "end": 1.852}, {"word": "Чехов.", "begin": 1.952, "end": 2.892}]}, {"text": "«Чайка».", "begin": 2.912, "end": 4.013, "words": [{"word": "«Чайка».", "begin": 2.912, "end": 4.013}]}, {"text": "Комедия в четырех действиях.", "begin": 4.033, "end": 6.654, "words": [{"word": "Комедия", "begin": 4.033, "end": 4.653}, {"word": "в", "begin": 4.693, "end": 4.733}, {"word": "четырех", "begin": 4.773, "end": 5.333}, {"word": "действиях.", "begin": 5.393, "end": 6.654}]}, {"text": "Действующие лица.", "begin": 6.714, "end": 8.534, "words": [{"word": "Действующие", "begin": 6.714, "end": 7.614}, {"word": "лица.", "begin": 7.654, "end": 8.534}]}, {"text": "Ирина Николаевна Аркадина, по мужу Треплева, актриса.", "begin": 8.594, "end": 13.296, "words": [{"word": "Ирина", "begin": 8.594, "end": 8.994}, {"word": "Николаевна", "begin": 9.034, "end": 9.775}, {"word": "Аркадина,", "begin": 9.795, "end": 10.655}, {"word": "по", "begin": 10.675, "end": 10.795}, {"word": "мужу", "begin": 10.835, "end": 11.155}, {"word": "Треплева,", "begin": 11.215, "end": 12.076}, {"word": "актриса.", "begin": 12.116, "end": 13.296}]}, {"text": "Константин Гаврилович Треплев, ее сын, молодой человек.", "begin": 13.316, "end": 18.138, "words": [{"word": "Константин", "begin": 13.316, "end": 14.056}, {"word": "Гаврилович", "begin": 14.096, "end": 14.797}, {"word": "Треплев,", "begin": 14.837, "end": 15.637}, {"word": "ее", "begin": 15.717, "end": 15.937}, {"word": "сын,", "begin": 16.037, "end": 16.517}, {"word": "молодой", "begin": 16.557, "end": 17.058}, {"word": "человек.", "begin": 17.118, "end": 18.138}]}, {"text": "Петр Николаевич Сорин, ее брат.", "begin": 18.218, "end": 21.54, "words": [{"word": "Петр", "begin": 18.218, "end": 18.578}, {"word": "Николаевич", "begin": 18.618, "end": 19.419}, {"word": "Сорин,", "begin": 19.519, "end": 20.159}, {"word": "ее", "begin": 20.279, "end": 20.599}, {"word": "брат.", "begin": 20.66, "end": 21.54}]}, {"text": "Нина Михайловна Заречная, молодая девушка, дочь богатого помещика.", "begin": 21.62, "end": 27.143, "words": [{"word": "Нина", "begin": 21.62, "end": 21.92}, {"word": "Михайловна", "begin": 21.96, "end": 22.661}, {"word": "Заречная,", "begin": 22.721, "end": 23.601}, {"word": "молодая", "begin": 23.621, "end": 24.122}, {"word": "девушка,", "begin": 24.182, "end": 24.942}, {"word": "дочь", "begin": 24.982, "end": 25.262}, {"word": "богатого", "begin": 25.302, "end": 25.883}, {"word": "помещика.", "begin": 25.943, "end": 27.143}]}, {"text": "Илья Афанасьевич Шамраев, поручик в отставке, управляющий у Сорина.", "begin": 27.203, "end": 33.587, "words": [{"word": "Илья", "begin": 27.203, "end": 27.844}, {"word": "Афанасьевич", "begin": 27.864, "end": 28.945}, {"word": "Шамраев,", "begin": 29.025, "end": 29.925}, {"word": "поручик", "begin": 29.965, "end": 30.505}, {"word": "в", "begin": 30.546, "end": 30.566}, {"word": "отставке,", "begin": 30.606, "end": 31.466}, {"word": "управляющий", "begin": 31.506, "end": 32.407}, {"word": "у", "begin": 32.427, "end": 32.507}, {"word": "Сорина.", "begin": 32.567, "end": 33.587}]}, {"text": "Полина Андреевна, его жена.", "begin": 33.627, "end": 36.329, "words": [{"word": "Полина", "begin": 33.627, "end": 34.128}, {"word": "Андреевна,", "begin": 34.168, "end": 35.108}, {"word": "его", "begin": 35.208, "end": 35.448}, {"word": "жена.", "begin": 35.509, "end": 36.329}]}, {"text": "Маша – его дочь.", "begin": 36.509, "end": 38.59, "words": [{"word": "Маша", "begin": 36.509, "end": 37.189}, {"word": "–", "begin": 37.209, "end": 37.229}, {"word": "его", "begin": 37.35, "end": 37.67}, {"word": "дочь.", "begin": 37.77, "end": 38.59}]}, {"text": "Борис Алексеевич Тригорин – билетрист.", "begin": 38.67, "end":