fix_chaika2.py
*.lock.moved

.vercel
public/books/index.json.bak
_to_delete/
_*.zip

__pycache__/

# generated glossary seeds (rebuilt on demand, pushed to R2)
tools/out/

# Pulled Vercel environments — plaintext secrets, never commit these.
# The existing .env / .env.local rules did NOT cover names like .env.vercel
# or .env.production, which is exactly what `vercel env pull <file>` writes.
.env.*
!.env.example

# OCR scans downloaded by tools/archive-en.mjs — large, regenerable
.cache/

# stray backups left by editing scripts
*.bak-*
*.bak
tools/ai-align-requests.jsonl
tools/ai-align-batch.json
tools/ai-align-findings.json
tools/ai-align-map.json
tools/alignment-review.html

# yt-dlp playlist and caption dumps — large, regenerable
tools/*-playlist.json
tools/bible-*.json
tools/*.vtt
tools/embed-check-*
tools/kob.jsonl
tools/knigaotboga.json

# auto-caption pulls for paragraph sync
tools/besy-p1.ru.vtt
tools/besy-p2.ru.vtt
tools/vtt/
tools/vtt-wanted.txt

# YouTube auto-captions fetched by yt-dlp for tools/align_video.py. ~37 MB and
# regenerable at any time from tools/captions/flagged-videos.txt, so the URL
# list is tracked and the captions themselves are not.
tools/captions/*.vtt

# yt-dlp metadata fetched for tools/scan_timestamps.py — ~50 MB of comment
# threads. The verified chapter marks extracted from them are what matters and
# those live in the manifest; the raw threads regenerate from meta-videos.txt.
tools/captions/*.info.json
tools/captions/*.description

# Intermediate output from tools/flatten_fb2.py — the accepted result is copied
# over the original and the previous version kept as .bak-preflatten.
*.fb2.new
