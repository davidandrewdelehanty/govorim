{"id": "PLNiKhbcXNVZj9TEY0ype9o92H2HwJ88ID", "title": "III \u0426\u0430\u0440\u0441\u0442\u0432 (\u0420\u0443\u0441\u0441\u043a\u0438\u0439 \u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u041f\u0435\u0440\u0435\u0432\u043e\u0434)", "availability": "public", "channel_follower_count": null, "description": "\u0422\u0440\u0435\u0442\u044c\u044f \u043a\u043d\u0438\u0433\u0430 \u0426\u0430\u0440\u0441\u0442\u0432 \u2014 \u0447\u0430\u0441\u0442\u044c \u0411\u0438\u0431\u043b\u0438\u0438, \u0412\u0435\u0442\u0445\u043e\u0433\u043e \u0417\u0430\u0432\u0435\u0442\u0430 \u0432 \u0421\u0435\u043f\u0442\u0443\u0430\u0433\u0438\u043d\u0442\u0435 \u0438 \u0432 \u043f\u0440\u0430\u0432\u043e\u0441\u043b\u0430\u0432\u043d\u043e\u043c \u043a\u0430\u043d\u043e\u043d\u0435. \u0412 \u0435\u0432\u0440\u0435\u0439\u0441\u043a\u043e\u0439 \u0411\u0438\u0431\u043b\u0438\u0438 (\u0422\u0430\u043d\u0430\u0445\u0435), \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432 \u043a\u0430\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0430\u043d\u0442\u0441\u043a\u043e\u043c \u043a\u0430\u043d\u043e\u043d\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u041f\u0435\u0440\u0432\u043e\u0439 \u043a\u043d\u0438\u0433\u0435 \u0426\u0430\u0440\u0435\u0439. \u0421\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 22 \u0433\u043b\u0430\u0432, \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0451\u043d\u043d\u043e\u0433\u043e \u0418\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0446\u0430\u0440\u0441\u0442\u0432\u0430, \u0435\u0433\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438 \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0418\u0443\u0434\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0438 \u0418\u0437\u0440\u0430\u0438\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0446\u0430\u0440\u0441\u0442\u0432.", "tags": [], "thumbnails": [{"url": "https://i.ytimg.com/vi/qCU_UfPUXaw/hqdefault.jpg?sqp=-oaymwEWCKgBEF5IWvKriqkDCQgBFQAAiEIYAQ==&rs=AOn4CLAw3ckBg2YNkHn7WzBuOYydjslyJw", "height": 94, "width": 168, "id": "0", "resolution": "168x94"}, {"url": "https://i.ytimg.com/vi/qCU_UfPUXaw/hqdefault.jpg?sqp=-oaymwEWCMQBEG5IWvKriqkDCQgBFQAAiEIYAQ==&rs=AOn4CLDCksZftnZwbdN6J2Zqh5l3c9C7jw", "height": 110, "width": 196, "id": "1", "resolution": "196x110"}, {"url": "https://i.ytimg.com/vi/qCU_UfPUXaw/hqdefault.jpg?sqp=-oaymwEXCPYBEIoBSFryq4qpAwkIARUAAIhCGAE=&rs=AOn4CLAgvUE78f_WVWamcO7wD-ty6LXVdg", "height": 138, "width": 246, "id": "2", "resolution": "246x138"}, {"url": "https://i.ytimg.com/vi/qCU_UfPUXaw/hqdefault.jpg?sqp=-oaymwEXCNACELwBSFryq4qpAwkIARUAAIhCGAE=&rs=AOn4CLBPHdIDTO_-BADWBElYKRqmftNJ7A", "height": 188, "width": 336, "id": "3", "resolution": "336x188"}], "modified_date": "20161202", "view_count": 971, "playlist_count": 22, "channel": "\u0411\u0438\u0431\u043b\u0438\u044f \u041e\u043d\u043b\u0430\u0439\u043d", "channel_id": "UCKZpQBLvGCVzHtyEg26dpOg", "uploader_id": "@\u0411\u0438\u0431\u043b\u0438\u044f\u041e\u043d\u043b\u0430\u0439\u043d-\u04385\u0443", "uploader": "\u0411\u0438\u0431\u043b\u0438\u044f \u041e\u043d\u043b\u0430\u0439\u043d", "channel_url": "https://www.youtube.com/channel/UCKZpQBLvGCVzHtyEg26dpOg", "uploader_url": "https://www.youtube.com/@\u0411\u0438\u0431\u043b\u0438\u044f\u041e\u043d\u043b\u0430\u0439\u043d-\u04385\u0443", "_type": "playlist", "entries": [{"title": "III \u0426\u0430\u0440\u0441\u0442\u0432 1 \u0433\u043b\u0430\u0432\u0430 \u0420\u0443\u0441\u0441\u043a\u0438\u0438\u0306 \u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0438\u0306 \u041f\u0435\u0440\u0435\u0432\u043e\u0434", "thumbnails": [{"url": "https://i.ytimg.com/vi/qCU_UfPUXaw/hqdefault.