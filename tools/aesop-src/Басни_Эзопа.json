437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041e\u0441\u0451\u043b \u0438 \u0435\u0433\u043e \u0445\u043e\u0437\u044f\u0435\u0432\u0430 ''(49)'']]\n# [[wikilivresru:\u041e\u0441\u0451\u043b \u0438 \u041b\u0438\u0440\u0430 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041e\u0441\u0451\u043b \u0438 \u043b\u0438\u0440\u0430 ''(21)'']] \n# [[wikilivresru:\u041e\u0441\u0451\u043b, \u041e\u043d\u0430\u0433\u0440 \u0438 \u041b\u0435\u0432 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041e\u0441\u0451\u043b, \u041e\u043d\u0430\u0433\u0440 \u0438 \u041b\u0435\u0432 ''(45)'']]\n# [[wikilivresru:\u041e\u0445\u043e\u0442\u043d\u0438\u043a \u0438 \u041b\u0435\u0432 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041e\u0445\u043e\u0442\u043d\u0438\u043a \u0438 \u041b\u0435\u0432 ''(31)'']]\n# [[wikilivresru:\u041f\u0435\u0442\u0443\u0445 \u0438 \u0416\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0430 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041f\u0435\u0442\u0443\u0445 \u0438 \u0416\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0430 ''(28)'']]\n# [[wikilivresru:\u041f\u0440\u043e\u0440\u043e\u043a (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u041f\u0440\u043e\u0440\u043e\u043a ''(4)'']]\n# [[wikilivresru:\u0420\u0435\u0437\u0432\u044b\u0439 \u041e\u0441\u0451\u043b (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0420\u0435\u0437\u0432\u044b\u0439 \u041e\u0441\u0451\u043b ''(10)'']] \n# [[wikilivresru:\u0420\u044b\u0431\u0430\u043a \u0438 \u0420\u044b\u0431\u044b (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0420\u044b\u0431\u0430\u043a \u0438 \u0420\u044b\u0431\u044b ''(39)'']] \n# [[wikilivresru:\u0421\u043a\u0443\u043f\u043e\u0439 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0421\u043a\u0443\u043f\u043e\u0439 ''(8)'']]\n# [[wikilivresru:\u0421\u043d\u044b \u043f\u0440\u0430\u0432\u0434\u0438\u0432\u044b\u0435 \u0438 \u043b\u0436\u0438\u0432\u044b\u0435 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0421\u043d\u044b \u043f\u0440\u0430\u0432\u0434\u0438\u0432\u044b\u0435 \u0438 \u043b\u0436\u0438\u0432\u044b\u0435 ''(17)'']]\n# [[wikilivresru:\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u043e\u0442 \u0443\u043a\u0443\u0441\u0430 \u0441\u043e\u0431\u0430\u043a\u0438 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u043e\u0442 \u0443\u043a\u0443\u0441\u0430 \u0441\u043e\u0431\u0430\u043a\u0438 '' (27)'']]\n# [[wikilivresru:\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u0417\u043c\u0435\u044f (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u0417\u043c\u0435\u044f ''(37)'']]\n# [[wikilivresru:\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u041b\u0435\u0432 (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u041b\u0435\u0432 ''(41)'']]\n# [[wikilivresru:\u042d\u0437\u043e\u043f \u0438 \u041f\u0438\u0441\u0430\u0442\u0435\u043b\u044c (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u042d\u0437\u043e\u043f \u0438 \u041f\u0438\u0441\u0430\u0442\u0435\u043b\u044c ''(14)'']]\n# [[wikilivresru:\u042d\u0444\u0438\u043e\u043f (\u042d\u0437\u043e\u043f/\u0421\u043c\u0438\u0440\u043d\u043e\u0432)|\u042d\u0444\u0438\u043e\u043f ''(13)'']] \n|}\n\n==\u0421\u043c. \u0442\u0430\u043a\u0436\u0435==\n* [[\u0424\u0435\u0434\u0440]]\n* [[\u0416\u0430\u043d \u041b\u0430\u0444\u043e\u043d\u0442\u0435\u043d]]\n* [[\u0418\u0432\u0430\u043d \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447 \u041a\u0440\u044b\u043b\u043e\u0432]]\n* [[\u041b\u0435\u0432 \u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0438\u0447 \u0422\u043e\u043b\u0441\u0442\u043e\u0439]]\n* [[\u0412\u0430\u